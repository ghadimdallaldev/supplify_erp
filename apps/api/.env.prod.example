# Supplify API — production (Railway prod environment only)
# All values via Railway secrets — never commit real prod credentials

APP_ENV=prod
NODE_ENV=production
PORT=4000

DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_SSL=true

CORS_ORIGIN=https://app.yourdomain.com
PUBLIC_FRONTEND_URL=https://app.yourdomain.com
PUBLIC_API_URL=https://api.yourdomain.com
WEB_ORIGIN=https://app.yourdomain.com

SESSION_SECRET=replace-with-openssl-rand-hex-32
CONSUMER_AUTH_SECRET=replace-with-different-openssl-rand-hex-32
IMPERSONATION_SECRET=replace-with-different-openssl-rand-hex-32

COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

AUTH_PROVIDER=keycloak
KEYCLOAK_URL=https://keycloak.yourdomain.com
KEYCLOAK_PUBLIC_URL=https://keycloak.yourdomain.com
KEYCLOAK_REALM=supplify-prod
KEYCLOAK_CLIENT_ID=supplify-api
KEYCLOAK_CLIENT_SECRET=replace-me
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-me

STORAGE_DRIVER=s3
STORAGE_ENDPOINT=https://your-account.r2.cloudflarestorage.com
STORAGE_PUBLIC_URL=https://cdn.yourdomain.com
STORAGE_BUCKET=supplify-prod
STORAGE_ACCESS_KEY_ID=replace-me
STORAGE_SECRET_ACCESS_KEY=replace-me
STORAGE_REGION=auto
STORAGE_PUBLIC_READ=false

PAYMENTS_MODE=live
PAYMENTS_PROVIDER=stripe
PAYMENTS_PUBLIC_KEY=replace-when-live
PAYMENTS_SECRET_KEY=replace-when-live
PAYMENTS_WEBHOOK_SECRET=replace-when-live

# Email — non-secret defaults in deploy/railway/production/api.env; secret: SMTP_PASS in dashboard
EMAIL_ENABLED=true
EMAIL_PROVIDER=smtp
EMAIL_LOG_ONLY=false
EMAIL_FROM_NAME=Supplify
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_FROM=noreply@yourdomain.com
# Railway Raw Editor only:
# SMTP_PASS=replace-me
# EMAIL_REPLY_TO=support@yourdomain.com

LOG_LEVEL=warn
ENABLE_REQUEST_LOGGING=false
ENABLE_SWAGGER=false
ENABLE_DEBUG_ROUTES=false
ENABLE_SEED_ROUTES=false
RATE_LIMIT_ENABLED=true
TRUST_PROXY=true

CRONS_ENABLED=true
# Default 3600000 (1 h) when NODE_ENV=production; override if needed
# CRON_SCHEDULED_ORDERS_INTERVAL_MS=3600000
# Default 86400000 (24 h) — expiry + reorder cadence reminders
# CRON_OPERATIONAL_REMINDERS_INTERVAL_MS=86400000

RUN_MIGRATIONS_ON_START=false
ALLOW_DB_RESET=false
SEED_DEMO_DATA=false

SENTRY_DSN=
SENTRY_ENVIRONMENT=prod

REDIS_URL=
DATABASE_POOL_MAX=20
DATABASE_POOL_IDLE_TIMEOUT_MS=600000
SLOW_REQUEST_MS=800
IDLE_PERF_LOG_MS=0
DB_KEEPALIVE_ENABLED=true
DB_KEEPALIVE_INTERVAL_SECONDS=60

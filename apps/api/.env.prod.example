# Supplify API — production (Railway prod environment only)
# All values via Railway secrets — never commit real prod credentials

APP_ENV=prod
NODE_ENV=production
PORT=4000

DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_SSL=true

CORS_ORIGIN=https://app.yourdomain.com
PUBLIC_FRONTEND_URL=https://app.yourdomain.com
PUBLIC_API_URL=https://api.yourdomain.com
WEB_ORIGIN=https://app.yourdomain.com

SESSION_SECRET=replace-with-openssl-rand-hex-32
IMPERSONATION_SECRET=replace-with-different-openssl-rand-hex-32

COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

AUTH_PROVIDER=keycloak
KEYCLOAK_URL=https://keycloak.yourdomain.com
KEYCLOAK_PUBLIC_URL=https://keycloak.yourdomain.com
KEYCLOAK_REALM=supplify-prod
KEYCLOAK_CLIENT_ID=supplify-api
KEYCLOAK_CLIENT_SECRET=replace-me
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-me

STORAGE_DRIVER=s3
STORAGE_ENDPOINT=https://your-account.r2.cloudflarestorage.com
STORAGE_PUBLIC_URL=https://cdn.yourdomain.com
STORAGE_BUCKET=supplify-prod
STORAGE_ACCESS_KEY_ID=replace-me
STORAGE_SECRET_ACCESS_KEY=replace-me
STORAGE_REGION=auto
STORAGE_PUBLIC_READ=false

PAYMENTS_MODE=live
PAYMENTS_PROVIDER=stripe
PAYMENTS_PUBLIC_KEY=replace-when-live
PAYMENTS_SECRET_KEY=replace-when-live
PAYMENTS_WEBHOOK_SECRET=replace-when-live

EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=replace-me
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

LOG_LEVEL=warn
ENABLE_REQUEST_LOGGING=false
ENABLE_SWAGGER=false
ENABLE_DEBUG_ROUTES=false
ENABLE_SEED_ROUTES=false
RATE_LIMIT_ENABLED=true
TRUST_PROXY=true

RUN_MIGRATIONS_ON_START=false
ALLOW_DB_RESET=false
SEED_DEMO_DATA=false

SENTRY_DSN=
SENTRY_ENVIRONMENT=prod

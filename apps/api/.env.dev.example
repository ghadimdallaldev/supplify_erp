# Supplify API — dev (local: copy to apps/api/.env)
# Railway: defaults load from deploy/railway/development/api.env on deploy.
# Secrets: deploy/railway/development/secrets.env.example → Railway Raw Editor

APP_ENV=dev
NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://user:pass@host:5432/supplify_dev
DATABASE_SSL=false

CORS_ORIGIN=http://localhost:5173,http://localhost:5174
PUBLIC_FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:5173

SESSION_SECRET=dev-only-change-me-not-for-hosted
CONSUMER_AUTH_SECRET=
IMPERSONATION_SECRET=

COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

AUTH_PROVIDER=keycloak
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_PUBLIC_URL=http://localhost:8180
KEYCLOAK_REALM=Supplify
KEYCLOAK_CLIENT_ID=supplify-api
KEYCLOAK_CLIENT_SECRET=changeme
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=uploads
API_PUBLIC_URL=http://localhost:4000
STORAGE_PUBLIC_URL=http://localhost:4000/uploads

PAYMENTS_MODE=mock
BILLING_GATEWAY=stub

LOG_LEVEL=debug
ENABLE_REQUEST_LOGGING=true
ENABLE_SWAGGER=true
ENABLE_DEBUG_ROUTES=true
ENABLE_SEED_ROUTES=true
RATE_LIMIT_ENABLED=false
TRUST_PROXY=true

CRONS_ENABLED=true
# CRON_SCHEDULED_ORDERS_INTERVAL_MS=300000
# CRON_OPERATIONAL_REMINDERS_INTERVAL_MS=86400000

RUN_MIGRATIONS_ON_START=false
ALLOW_DB_RESET=true
SEED_DEMO_DATA=true

# Local: redis://localhost:6379 after pnpm local:infra — Docker API: redis://redis:6379
# Railway API: REDIS_URL=${{your-redis.REDIS_URL}} — never REDIS_PUBLIC_URL (egress)
REDIS_URL=redis://localhost:6379

DATABASE_POOL_MAX=20
DATABASE_POOL_IDLE_TIMEOUT_MS=600000
SLOW_REQUEST_MS=800
IDLE_PERF_LOG_MS=500
DB_KEEPALIVE_ENABLED=true
DB_KEEPALIVE_INTERVAL_SECONDS=60

# Email — Railway loads deploy/railway/development/api.env (EMAIL_LOG_ONLY=true)
# Local native dev: pnpm local:infra starts Mailpit → SMTP localhost:1025, UI http://localhost:8025
EMAIL_ENABLED=true
EMAIL_PROVIDER=smtp
EMAIL_LOG_ONLY=false
EMAIL_FROM_NAME=Supplify
EMAIL_FROM_ADDRESS=noreply@supplify.local
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@supplify.local

SENTRY_DSN=
SENTRY_ENVIRONMENT=dev

# Delivery rollover (off by default — enable on dev to test nightly job)
DELIVERY_ROLLOVER_ENABLED=false
DELIVERY_ROLLOVER_CUTOFF_HOUR=3
DELIVERY_ROLLOVER_TIMEZONE=Asia/Beirut
DELIVERY_ROLLOVER_KEEP_DRIVER=true
CRON_DELIVERY_ROLLOVER_INTERVAL_MS=3600000

# Web Push — pnpm vapid:generate (writes deploy/env/.env.vapid) or set manually:
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_EMAIL=notifications@supplify.local

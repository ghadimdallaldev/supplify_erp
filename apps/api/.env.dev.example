# Supplify API — dev (local: copy to apps/api/.env)
# Railway: defaults load from deploy/railway/development/api.env on deploy.
# Secrets: deploy/railway/development/secrets.env.example → Railway Raw Editor

APP_ENV=dev
NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://user:pass@host:5432/supplify_dev
DATABASE_SSL=false

CORS_ORIGIN=http://localhost:5173,http://localhost:5174
PUBLIC_FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:5173

SESSION_SECRET=dev-only-change-me-not-for-hosted
IMPERSONATION_SECRET=

COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

AUTH_PROVIDER=keycloak
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_PUBLIC_URL=http://localhost:8180
KEYCLOAK_REALM=Supplify
KEYCLOAK_CLIENT_ID=supplify-api
KEYCLOAK_CLIENT_SECRET=changeme
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=uploads
API_PUBLIC_URL=http://localhost:4000
STORAGE_PUBLIC_URL=http://localhost:4000/uploads

PAYMENTS_MODE=mock
BILLING_GATEWAY=stub

LOG_LEVEL=debug
ENABLE_REQUEST_LOGGING=true
ENABLE_SWAGGER=true
ENABLE_DEBUG_ROUTES=true
ENABLE_SEED_ROUTES=true
RATE_LIMIT_ENABLED=false
TRUST_PROXY=true

CRONS_ENABLED=true
# CRON_SCHEDULED_ORDERS_INTERVAL_MS=300000

RUN_MIGRATIONS_ON_START=false
ALLOW_DB_RESET=true
SEED_DEMO_DATA=true

REDIS_URL=
SENTRY_DSN=
SENTRY_ENVIRONMENT=dev

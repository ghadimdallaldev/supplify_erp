{
  "name": "@supplify/api",
  "version": "2.0.0",
  "description": "Supplify API Server",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "build": "echo 'Build not needed for JS'",
    "start": "node src/server.js",
    "typecheck": "echo 'Typecheck not needed for JS'",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:run": "vitest run",
    "test:coverage": "vitest --coverage",
    "test:e2e": "vitest run --config ../../tests/e2e/vitest.config.js",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write \"src/**/*.{js,json}\"",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "seed:prodlike": "node scripts/prodlike.seed.js",
    "seed:accounts": "node scripts/seed-accounts-for-prodlike.js",
    "seed:quick-lists": "node scripts/seed-quick-lists.js",
    "seed:chats": "node scripts/seed-chats.js",
    "seed:demo-users": "node scripts/seed-demo-users.js",
    "reduce-to-single-tenant": "node scripts/reduce-to-single-tenant.js",
    "db:reset": "node scripts/reset.js",
    "db:init-subs": "node scripts/initialize-subscriptions.js",
    "openapi:gen": "node scripts/generate-openapi.js"
  },
  "dependencies": {
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "axios": "^1.13.5",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.17.3",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jose": "^5.2.0",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.13.0",
    "node-fetch": "^3.3.2",
    "pg": "^8.11.3",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "socket.io": "^4.8.1",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.1.0",
    "supertest": "^6.3.3",
    "vitest": "^1.1.0",
    "@vitest/coverage-v8": "^1.1.0"
  }
}

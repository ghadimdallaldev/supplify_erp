{
  "name": "@supplify/api",
  "version": "2.0.0",
  "description": "Supplify API Server",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "echo 'Build not needed for JS'",
    "start": "node src/server.js",
    "typecheck": "echo 'Typecheck not needed for JS'",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:run": "vitest run",
    "test:rbac": "vitest run src/lib/rbac-full-app.test.js src/lib/rbac-role-access.test.js src/lib/rbac-guards.test.js src/lib/rbac.impersonation.test.js src/lib/driver-user-link.test.js src/routes/promotions.rbac.test.js",
    "test:coverage": "vitest --coverage",
    "test:e2e": "vitest run --config ../../tests/e2e/vitest.config.js",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write \"src/**/*.{js,json}\"",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "seed:prodlike": "node scripts/prodlike.seed.js",
    "seed:accounts": "node scripts/seed-accounts-for-prodlike.js",
    "seed:quick-lists": "node scripts/seed-quick-lists.js",
    "seed:chats": "node scripts/seed-chats.js",
    "seed:demo-users": "node scripts/seed-demo-users.js",
    "seed:demo-tenants": "node scripts/seed-demo-tenants.js",
    "seed:plan-tiers": "node scripts/seed-plan-tier-demos.js",
    "seed:billing": "node scripts/seed-billing.js",
    "seed:prodlike-team": "node scripts/seed-prodlike-team-backfill.js",
    "seed:full": "node scripts/seed-full.mjs",
    "seed:features": "node scripts/seed-feature-demos.js",
    "seed:tier-catalog": "node scripts/seed-tier-catalog.js",
    "log:tier-limits": "node scripts/log-tier-limits.mjs",
    "reduce-to-single-tenant": "node scripts/reduce-to-single-tenant.js",
    "db:wipe-commercial": "node scripts/wipe-commercial-only.js",
    "db:wipe-all": "node scripts/wipe-all-data.js",
    "db:reset": "node scripts/reset.js",
    "db:init-subs": "node scripts/initialize-subscriptions.js",
    "openapi:gen": "node scripts/generate-openapi.js",
    "storage:ensure-buckets": "node scripts/ensure-minio-buckets.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@sendgrid/mail": "^8.1.4",
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "axios": "^1.13.5",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.17.3",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jose": "^5.2.0",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.13",
    "pdfkit": "^0.13.0",
    "pg": "^8.11.3",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "socket.io": "^4.8.1",
    "twilio": "^5.4.0",
    "uuid": "^9.0.1",
    "web-push": "^3.6.7",
    "zod": "^3.22.4"
  }
}

# Supplify API — local dev template (never commit real secrets)
# Railway / hosted: use .env.dev.example | .env.preprod.example | .env.prod.example
# See docs/deployment/environment-variables.md and docs/deployment/railway-environments.md

NODE_ENV=development
PORT=4000

# Logging (production: LOG_LEVEL=info, LOG_FORMAT=json)
LOG_LEVEL=debug
LOG_FORMAT=pretty

# Dev only: allow deal boost without payment (never set true in production)
# ALLOW_WAIVE_DEAL_PROMOTION_PAYMENT=true

# Comma-separated browser origins allowed for CORS (must match your Vite dev server)
WEB_ORIGIN=http://localhost:5173
WEB_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# PostgreSQL — local Docker: set POSTGRES_* in docker/.env (run pnpm local:infra).
# Native dev auto-syncs apps/api/.env.docker-sync; override here only for a non-Docker DB:
# DATABASE_URL=postgresql://user:pass@localhost:5432/mydb
# SUPPLIFY_DATABASE_URL=postgresql://...  (always wins)
DATABASE_SSL=false
# DATABASE_STATEMENT_TIMEOUT=30000

# Keycloak OIDC
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_REALM=Supplify
KEYCLOAK_CLIENT_ID=supplify-api
KEYCLOAK_CLIENT_SECRET=changeme
# Keycloak master-realm admin (invite signup creates users via Admin API; local Docker default is admin/admin)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Session & impersonation (use openssl rand -hex 32 in production)
SESSION_SECRET=dev-session-secret-change-me
# B2C diner JWT cookie (consumer_auth_token) — NOT Keycloak; defaults to SESSION_SECRET if unset
CONSUMER_AUTH_SECRET=
IMPERSONATION_SECRET=
IMPERSONATION_MAX_DURATION_MINUTES=60

# Object storage — local disk (default) or S3-compatible (MinIO/R2)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=uploads
API_PUBLIC_URL=http://localhost:4000
STORAGE_PUBLIC_URL=http://localhost:4000/uploads

# Docker/MinIO local stack (pnpm dev with infra) — use s3 driver:
# STORAGE_DRIVER=s3
# STORAGE_ENDPOINT=http://localhost:9000
# STORAGE_PUBLIC_URL=http://localhost:9000
# STORAGE_BUCKET=supplify
# STORAGE_BUCKETS=supplify
# STORAGE_ACCESS_KEY_ID=minioadmin
# STORAGE_SECRET_ACCESS_KEY=minioadmin
# STORAGE_PUBLIC_READ=true

# Staff portal & public booking URLs (browser-facing)
STAFF_PORTAL_BASE_URL=http://localhost:5173
PUBLIC_RESERVATION_BASE_URL=http://localhost:5173

# Email system (Nodemailer SMTP — Resend recommended for production)
EMAIL_ENABLED=true
EMAIL_PROVIDER=smtp
EMAIL_LOG_ONLY=false
EMAIL_FROM_NAME=Supplify
EMAIL_FROM_ADDRESS=noreply@supplify.local
EMAIL_REPLY_TO=
EMAIL_TEST_TO=test@supplify.local

# Local dev (default): Mailpit via pnpm local:infra — UI http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=noreply@supplify.local

# Production (Resend): uncomment and set SMTP_PASS in Railway secrets
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=
# EMAIL_FROM_ADDRESS=noreply@yourdomain.com

# Or EMAIL_LOG_ONLY=true to skip network send (console preview only)

# WhatsApp (Meta / WhatsApp Cloud API). Wiring is complete; real delivery activates
# only when WHATSAPP_ENABLED=true and an access token + phone number id are set.
# Gated per tenant by the "email_and_whatsapp" / "email_whatsapp_webhook" plan feature.
WHATSAPP_ENABLED=false
# WHATSAPP_LOG_ONLY=true to preview messages in logs without a network send (dev).
WHATSAPP_LOG_ONLY=false
# From Meta Business > WhatsApp > API setup:
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# Web Push (VAPID) — npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_EMAIL=notifications@yourdomain.com

# Driver GPS / live tracking (backend)
GPS_TRACKING_ENABLED=true
GPS_STALE_AFTER_SECONDS=300
GPS_UPDATE_INTERVAL_SECONDS=15
GPS_MIN_ACCURACY_METERS=100
GPS_LOCATION_RETENTION_DAYS=90
GPS_ALLOW_RESTAURANT_LIVE_TRACKING=true
GPS_RESTAURANT_SHOW_DRIVER_NAME=true
GPS_RESTAURANT_SHOW_DRIVER_PHONE=false
GPS_ALLOW_DRIVER_BACKGROUND_HINT=true
DELIVERY_ETA_CITY_SPEED_KMH=20
DELIVERY_ETA_MIN_MULTIPLIER=1.0
DELIVERY_ETA_MAX_MULTIPLIER=1.5
MAP_PROVIDER=google
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# Optional — Redis recommended (permissions, subscription, entitlements cache)
REDIS_URL=

# Performance / pool (local: keepalive off unless NODE_ENV=production)
DATABASE_POOL_MAX=20
DATABASE_POOL_IDLE_TIMEOUT_MS=600000
SLOW_REQUEST_MS=800
IDLE_PERF_LOG_MS=0
DB_KEEPALIVE_ENABLED=false
DB_KEEPALIVE_INTERVAL_SECONDS=60

CRONS_ENABLED=true
# CRON_OPERATIONAL_REMINDERS_INTERVAL_MS=86400000

# AI platform (Smart Reorder LLM explain + NL ask — off by default)
AI_ENABLED=false
AI_PROVIDER=openai
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
# Hard ceiling per tenant per day (plan limits also apply via ai_requests_per_day)
AI_MAX_REQUESTS_PER_TENANT_PER_DAY=50

E2E_SECRET=
BILLING_GATEWAY=stub

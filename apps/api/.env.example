# Supplify API — copy to apps/api/.env (never commit real secrets)

NODE_ENV=development
PORT=4000

# Logging (production: LOG_LEVEL=info, LOG_FORMAT=json)
LOG_LEVEL=debug
LOG_FORMAT=pretty

# Dev only: allow deal boost without payment (never set true in production)
# ALLOW_WAIVE_DEAL_PROMOTION_PAYMENT=true

# Comma-separated browser origins allowed for CORS (must match your Vite dev server)
WEB_ORIGIN=http://localhost:5173
WEB_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/supplify
DATABASE_SSL=false
# DATABASE_STATEMENT_TIMEOUT=30000

# Keycloak OIDC
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_REALM=Supplify
KEYCLOAK_CLIENT_ID=supplify-api
KEYCLOAK_CLIENT_SECRET=changeme

# Session & impersonation (use openssl rand -hex 32 in production)
SESSION_SECRET=dev-session-secret-change-me
IMPERSONATION_SECRET=
IMPERSONATION_MAX_DURATION_MINUTES=60

# Object storage (MinIO — S3-compatible API, not AWS)
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_BUCKET=supplify
# Optional: comma-separated buckets to create (e.g. supplify,supplify-media). Defaults to S3_BUCKET.
# S3_BUCKETS=supplify
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# Allow browsers to load image_url via GET (set false if you add signed-URL downloads later)
# S3_PUBLIC_READ=true

# Staff portal & public booking URLs (browser-facing)
STAFF_PORTAL_BASE_URL=http://localhost:5173
PUBLIC_RESERVATION_BASE_URL=http://localhost:5173

# Twilio — WhatsApp (Programmable Messaging)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Twilio Email (SendGrid API key from https://console.twilio.com → Email)
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=noreply@yourdomain.com
# SENDGRID_FROM_NAME=Supplify

# SMTP fallback (optional if using SendGrid above)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=<SendGrid API key>
# SMTP_SECURE=false
# SMTP_FROM=noreply@example.com

# Web Push (VAPID) — npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_EMAIL=notifications@yourdomain.com

# Optional
REDIS_URL=
E2E_SECRET=
BILLING_GATEWAY=stub

# Supplify API — preprod / UAT (Railway preprod environment only)
# Copy keys into Railway variables — do NOT reuse prod secrets or DATABASE_URL

APP_ENV=preprod
NODE_ENV=production
PORT=4000

DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_SSL=true

CORS_ORIGIN=https://supplify-web-preprod.up.railway.app
PUBLIC_FRONTEND_URL=https://supplify-web-preprod.up.railway.app
PUBLIC_API_URL=https://supplify-api-preprod.up.railway.app
WEB_ORIGIN=https://supplify-web-preprod.up.railway.app

SESSION_SECRET=replace-with-openssl-rand-hex-32
IMPERSONATION_SECRET=replace-with-different-openssl-rand-hex-32

COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

AUTH_PROVIDER=keycloak
KEYCLOAK_URL=https://keycloak-preprod.example.com
KEYCLOAK_PUBLIC_URL=https://keycloak-preprod.example.com
KEYCLOAK_REALM=supplify-preprod
KEYCLOAK_CLIENT_ID=supplify-api
KEYCLOAK_CLIENT_SECRET=replace-me
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-me

STORAGE_DRIVER=s3
STORAGE_ENDPOINT=https://your-account.r2.cloudflarestorage.com
STORAGE_PUBLIC_URL=https://pub-preprod.example.com
STORAGE_BUCKET=supplify-preprod
STORAGE_ACCESS_KEY_ID=replace-me
STORAGE_SECRET_ACCESS_KEY=replace-me
STORAGE_REGION=auto

PAYMENTS_MODE=test
PAYMENTS_PROVIDER=stub
PAYMENTS_WEBHOOK_SECRET=replace-when-testing-webhooks

EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=replace-me
SENDGRID_FROM_EMAIL=noreply@preprod.example.com

LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true
ENABLE_SWAGGER=false
ENABLE_DEBUG_ROUTES=false
ENABLE_SEED_ROUTES=false
RATE_LIMIT_ENABLED=true
TRUST_PROXY=true

RUN_MIGRATIONS_ON_START=false
ALLOW_DB_RESET=false
SEED_DEMO_DATA=false

SENTRY_DSN=
SENTRY_ENVIRONMENT=preprod

# Railway API service — copy variables into Railway dashboard (never commit secrets)

NODE_ENV=production
# PORT is set automatically by Railway

DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_SSL=true
# Leave unset (defaults false) for Railway Postgres; set true only with a custom CA bundle.

WEB_ORIGIN=https://your-frontend.up.railway.app
WEB_ORIGINS=https://your-frontend.up.railway.app

SESSION_SECRET=replace-with-openssl-rand-hex-32
IMPERSONATION_SECRET=

KEYCLOAK_BASE_URL=https://your-keycloak.example.com
KEYCLOAK_PUBLIC_URL=https://your-keycloak.example.com
KEYCLOAK_REALM=Supplify
KEYCLOAK_CLIENT_ID=supplify-api
KEYCLOAK_CLIENT_SECRET=replace-me
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-me

# Storage — local MVP (add a Railway volume on ./uploads for persistence)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=uploads
API_PUBLIC_URL=https://your-api.up.railway.app
STORAGE_PUBLIC_URL=https://your-api.up.railway.app/uploads

# Optional: S3-compatible (Cloudflare R2, MinIO)
# STORAGE_DRIVER=s3
# STORAGE_ENDPOINT=
# STORAGE_PUBLIC_URL=
# STORAGE_BUCKET=supplify
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_REGION=auto

REDIS_URL=
BILLING_GATEWAY=stub

CRONS_ENABLED=true
# CRON_SCHEDULED_ORDERS_INTERVAL_MS=3600000

# Email (required in production — API validates on startup)
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# Railway API service — copy variables into Railway dashboard (never commit secrets)

NODE_ENV=production
# PORT is set automatically by Railway

DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_SSL=true
# Leave unset (defaults false) for Railway Postgres; set true only with a custom CA bundle.

WEB_ORIGIN=https://your-frontend.up.railway.app
WEB_ORIGINS=https://your-frontend.up.railway.app

SESSION_SECRET=replace-with-openssl-rand-hex-32
IMPERSONATION_SECRET=

KEYCLOAK_BASE_URL=https://your-keycloak.example.com
KEYCLOAK_PUBLIC_URL=https://your-keycloak.example.com
KEYCLOAK_REALM=Supplify
KEYCLOAK_CLIENT_ID=supplify-api
KEYCLOAK_CLIENT_SECRET=replace-me
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-me

# Storage — local MVP (add a Railway volume on ./uploads for persistence)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=uploads
API_PUBLIC_URL=https://your-api.up.railway.app
STORAGE_PUBLIC_URL=https://your-api.up.railway.app/uploads

# Optional: S3-compatible (Cloudflare R2, MinIO)
# STORAGE_DRIVER=s3
# STORAGE_ENDPOINT=
# STORAGE_PUBLIC_URL=
# STORAGE_BUCKET=supplify
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_REGION=auto

# Private Redis on API only — use REDIS_URL, NOT REDIS_PUBLIC_URL (public proxy = egress fees).
REDIS_URL=${{Redis.REDIS_URL}}

# Performance / idle warmth (also in deploy/railway/<env>/api.env)
DATABASE_POOL_MAX=20
DATABASE_POOL_IDLE_TIMEOUT_MS=600000
SLOW_REQUEST_MS=800
IDLE_PERF_LOG_MS=500
DB_KEEPALIVE_ENABLED=true
DB_KEEPALIVE_INTERVAL_SECONDS=60

BILLING_GATEWAY=stub

CRONS_ENABLED=true
# CRON_SCHEDULED_ORDERS_INTERVAL_MS=3600000
# CRON_OPERATIONAL_REMINDERS_INTERVAL_MS=86400000

GPS_TRACKING_ENABLED=true
GPS_STALE_AFTER_SECONDS=300
GPS_UPDATE_INTERVAL_SECONDS=15
GPS_ALLOW_RESTAURANT_LIVE_TRACKING=true
GPS_RESTAURANT_SHOW_DRIVER_NAME=true
GPS_RESTAURANT_SHOW_DRIVER_PHONE=false
GPS_LOCATION_RETENTION_DAYS=90

# Email — prefer committed deploy/railway/<env>/api.env + SMTP_PASS in Raw Editor
# EMAIL_ENABLED=true
# EMAIL_PROVIDER=smtp
# EMAIL_LOG_ONLY=false
# EMAIL_FROM_NAME=Supplify
# EMAIL_FROM_ADDRESS=noreply@yourdomain.com
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=replace-me
# SMTP_FROM=noreply@yourdomain.com

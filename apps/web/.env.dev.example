# Supplify Web — dev (local: copy to apps/web/.env)
# Railway: baked from deploy/railway/development/web.env at Docker build

VITE_APP_ENV=dev
# Business model: v1 (default) | v2 (supplier-first experiment)
# VITE_SUPPLIFY_MODEL_VERSION=v1
VITE_API_URL=
VITE_PUBLIC_FRONTEND_URL=http://localhost:5173

VITE_AUTH_PROVIDER=keycloak
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=Supplify
VITE_KEYCLOAK_CLIENT_ID=supplify-web

VITE_PAYMENTS_MODE=mock
VITE_PAYMENTS_PUBLIC_KEY=

VITE_ENABLE_DEBUG_UI=true
VITE_ENABLE_DEMO_BANNERS=true
VITE_ENABLE_MOCK_PAYMENTS=true
VITE_ENABLE_TEST_DATA=true

VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=dev

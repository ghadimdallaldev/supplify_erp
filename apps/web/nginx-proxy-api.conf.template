    # Same-origin proxy to API (auth cookies are first-party — required on mobile Chrome).
    #
    # Connections go through the `supplify_api` upstream (defined in the http block) which
    # keeps a pool of keepalive connections to the API edge — without it nginx opens a new
    # TLS connection per request, adding a handshake to every same-origin /api and /auth
    # call. proxy_http_version 1.1 + Connection "" are required for upstream keepalive.
    #
    # Host/SNI: the upstream name is not the real host, so set Host and proxy_ssl_name to
    # ${API_HOST} explicitly. Host MUST be the API host (not $host): Railway's edge routes
    # by Host header, and the web host would loop back to this service => 508. X-Forwarded-Host
    # carries the original web host so the API builds first-party callback URLs (callbackOrigin).
    #
    # Buffers: /auth/callback sets two large JWT cookies (access_token + refresh_token); the
    # combined Set-Cookie headers exceed nginx's default proxy_buffer_size => 502. Enlarge.
    location /auth/ {
        proxy_pass https://supplify_api/auth/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_ssl_server_name on;
        proxy_ssl_name ${API_HOST};
        proxy_set_header Host ${API_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_buffer_size 16k;
        proxy_buffers 8 16k;
        proxy_busy_buffers_size 32k;
        proxy_read_timeout 120s;
    }

    location /api/ {
        proxy_pass https://supplify_api/api/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_ssl_server_name on;
        proxy_ssl_name ${API_HOST};
        proxy_set_header Host ${API_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_buffer_size 16k;
        proxy_buffers 8 16k;
        proxy_busy_buffers_size 32k;
        proxy_read_timeout 120s;
    }

    location /socket.io/ {
        proxy_pass https://supplify_api/socket.io/;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_ssl_name ${API_HOST};
        proxy_set_header Host ${API_HOST};
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 86400s;
    }

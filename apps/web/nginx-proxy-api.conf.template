    # Same-origin proxy to API (auth cookies are first-party — required on mobile Chrome).
    #
    # Host header: DO NOT set it to $host (the web host). ${API_UPSTREAM} is a public
    # *.up.railway.app URL and Railway's edge routes by Host header — sending the web host
    # makes the edge bounce the request back to this web service => 508 Loop Detected.
    # Leaving Host unset lets nginx default it to $proxy_host (the API host from proxy_pass),
    # so the edge routes to the API. X-Forwarded-Host carries the original web host so the
    # API can build first-party callback URLs (see callbackOrigin in auth.routes.js).
    #
    # Buffers: /auth/callback sets two large JWT cookies (access_token + refresh_token).
    # The combined Set-Cookie headers exceed nginx's default proxy_buffer_size, which
    # surfaces as "upstream sent too big header" => 502 Bad Gateway. Enlarge the buffers.
    location /auth/ {
        proxy_pass ${API_UPSTREAM}/auth/;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_buffer_size 16k;
        proxy_buffers 8 16k;
        proxy_busy_buffers_size 32k;
        proxy_read_timeout 120s;
    }

    location /api/ {
        proxy_pass ${API_UPSTREAM}/api/;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_buffer_size 16k;
        proxy_buffers 8 16k;
        proxy_busy_buffers_size 32k;
        proxy_read_timeout 120s;
    }

    location /socket.io/ {
        proxy_pass ${API_UPSTREAM}/socket.io/;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 86400s;
    }

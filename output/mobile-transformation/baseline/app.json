{
  "expo": {
    "name": "Supplify",
    "slug": "supplify-mobile",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "supplify",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.supplify.mobile",
      "buildNumber": "11",
      "associatedDomains": [
        "applinks:app.supplifyerp.com"
      ],
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Supplify uses your location to validate a public delivery address and while you are handling an active delivery.",
        "NSCameraUsageDescription": "Supplify uses the camera to capture proof-of-delivery photos.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.supplify.mobile",
      "versionCode": 11,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#5B21B6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "app.supplifyerp.com",
              "pathPrefix": "/supplier/"
            },
            {
              "scheme": "https",
              "host": "app.supplifyerp.com",
              "pathPrefix": "/order/track/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Supplify to use your location for delivery-address validation and active deliveries.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": false,
          "cameraPermission": "Allow Supplify to capture proof-of-delivery photos.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#5822B4",
          "defaultChannel": "supplify-alerts"
        }
      ],
      "expo-font"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "69e55e43-93dc-4f9f-b424-b2a21e74e189"
      }
    },
    "owner": "supplify-team"
  }
}

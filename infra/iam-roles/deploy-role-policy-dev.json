{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "cloudformation:*",
        "ecs:*",
        "ecr:*",
        "rds:*",
        "logs:*",
        "s3:*",
        "ec2:*",
        "secretsmanager:*",
        "route53:*",
        "acm:*",
        "cloudfront:*",
        "elasticloadbalancing:*",
        "application-autoscaling:*",
        "events:*",
        "ssm:*",
        "sts:GetCallerIdentity",
        "iam:PassRole",
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:ListRoles",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:GetRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:ListRoleTags",
        "xray:*",
        "cloudwatch:*",
        "wafv2:*"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Environment": "dev"
        }
      }
    }
  ]
}

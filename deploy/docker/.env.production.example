# Production environment — copy to deploy/docker/.env before first deploy.
# Replace CHANGE_ME values and set PUBLIC_URL to your EC2 public IP or domain.

NODE_ENV=production
PUBLIC_URL=http://CHANGE_ME

# ── Secrets (generate with: openssl rand -hex 32) ─────────────────────────────
POSTGRES_PASSWORD=CHANGE_ME
RABBITMQ_PASSWORD=CHANGE_ME
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
KEYCLOAK_DB_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=supplify
POSTGRES_DB=supplify
DATABASE_URL=postgresql://supplify:CHANGE_ME@postgres:5432/supplify

# ── Messaging / cache ─────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
RABBITMQ_URL=amqp://supplify:CHANGE_ME@rabbitmq:5672

# ── Search ────────────────────────────────────────────────────────────────────
ELASTICSEARCH_URL=http://elasticsearch:9200

# ── AWS (use real credentials on EC2; omit AWS_ENDPOINT for real S3) ──────────
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
S3_BUCKET=supplify-assets-prod

# ── Keycloak ──────────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KC_HOSTNAME=CHANGE_ME
KC_HOSTNAME_STRICT=false
KC_HTTP_ENABLED=true
KC_PROXY=edge
NEXT_PUBLIC_KEYCLOAK_REALM=Supplify
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=supplify-web

# ── Public URLs (used at web image build time) ────────────────────────────────
NEXT_PUBLIC_API_GATEWAY_URL=${PUBLIC_URL}/graphql
NEXT_PUBLIC_KEYCLOAK_URL=${PUBLIC_URL}/auth
NEXT_PUBLIC_CHAT_WS_URL=${PUBLIC_URL}/chat

# ── Internal service URLs (server-side, Docker network) ───────────────────────
CORS_ORIGIN=${PUBLIC_URL}
CHAT_SERVICE_URL=http://chat:3011
INVENTORY_SERVICE_URL=http://inventory:3005
ORDERS_SERVICE_URL=http://orders:3002

# ── API Gateway ───────────────────────────────────────────────────────────────
PORT=4000
API_PORT=4000
WEB_PORT=3000
LOG_LEVEL=info

# ── SendGrid (optional) ───────────────────────────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

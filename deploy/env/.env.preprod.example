# ====== REQUIRED ======
POSTGRES_PASSWORD=change_me

# ====== DATABASE ======
POSTGRES_DB=supplify
POSTGRES_USER=supplify
DATABASE_URL=postgresql://supplify:change_me@postgres:5432/supplify

# ====== APP PORTS (preprod: different from prod/dev) ======
BACKEND_PORT=3020
FRONTEND_PORT=3021

# ====== IMAGES (optional override) ======
BACKEND_IMAGE=supplify-backend:preprod
FRONTEND_IMAGE=supplify-frontend:preprod

# ====== BACKUP SETTINGS ======
BACKUP_RETENTION_DAYS=14
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=supplify-preprod
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

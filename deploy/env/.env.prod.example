# ====== REQUIRED — auto-generated on first run by deploy-prod.sh ======
POSTGRES_PASSWORD=change_me
SESSION_SECRET=change_me
MINIO_ROOT_PASSWORD=change_me
KEYCLOAK_ADMIN_PASSWORD=change_me

# ====== PUBLIC URL — set your production domain ======
PUBLIC_URL=http://localhost

# ====== AUTO-DERIVED from PUBLIC_URL by deploy-prod.sh ======
VITE_API_URL=http://localhost
VITE_KEYCLOAK_URL=http://localhost:8180
WEB_ORIGIN=http://localhost

# ====== DATABASE ======
POSTGRES_DB=supplify
POSTGRES_USER=supplify
DATABASE_URL=postgresql://supplify:change_me@postgres:5432/supplify

# ====== KEYCLOAK ======
KEYCLOAK_ADMIN=admin
KEYCLOAK_REALM=Supplify
KEYCLOAK_CLIENT_ID=supplify-api
# IMPORTANT: change this for production — also update in Keycloak admin console
KEYCLOAK_CLIENT_SECRET=changeme

# ====== MINIO (S3-compatible object storage — not AWS) ======
MINIO_ROOT_USER=minioadmin
# Primary bucket for uploads; must match a name in S3_BUCKETS (or leave S3_BUCKETS unset).
S3_BUCKET=supplify
# Optional: comma-separated buckets to create at deploy (e.g. supplify,supplify-media)
# S3_BUCKETS=supplify
# API → MinIO inside Docker network
S3_ENDPOINT=http://minio:9000
# Browser-facing URL for product.image_url (set by deploy-prod.sh from PUBLIC_URL)
S3_PUBLIC_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change_me
# Public GET on uploaded files (product images). Set false if you add signed URLs only.
S3_PUBLIC_READ=true
MINIO_PUBLIC_READ=true

# ====== REDIS ======
REDIS_URL=redis://redis:6379

# ====== PORTS ======
BACKEND_PORT=4000
HTTP_PORT=80
KEYCLOAK_PORT=8180

# ====== NODE ======
NODE_ENV=production

# ====== Web Push (VAPID) — npx web-push generate-vapid-keys ======
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=notifications@yourdomain.com

# ====== Twilio WhatsApp ======
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+1xxxxxxxxxx

# ====== Twilio Email (SendGrid) ======
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=Supplify
STAFF_PORTAL_BASE_URL=https://yourdomain.com

# ====== SMTP fallback (optional) ======
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=
# SMTP_SECURE=false
# SMTP_FROM=noreply@yourdomain.com

# ====== IMAGES (set automatically by deploy-prod.sh) ======
BACKEND_IMAGE=supplify-backend:prod
FRONTEND_IMAGE=supplify-frontend:prod

# ====== BACKUP ======
BACKUP_DIR=/opt/supplify/backups
BACKUP_RETENTION_DAYS=14
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=supplify
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

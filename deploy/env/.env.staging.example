# ====== AUTO-GENERATED on first run by deploy-staging.sh ======
POSTGRES_PASSWORD=change_me
SESSION_SECRET=change_me
MINIO_ROOT_PASSWORD=change_me
KEYCLOAK_ADMIN_PASSWORD=change_me

# ====== PUBLIC URL — set your staging domain ======
PUBLIC_URL=http://localhost

# ====== AUTO-DERIVED from PUBLIC_URL by deploy-staging.sh ======
VITE_API_URL=http://localhost
VITE_KEYCLOAK_URL=http://localhost:8180
WEB_ORIGIN=http://localhost

# ====== DATABASE ======
POSTGRES_DB=supplify
POSTGRES_USER=supplify
DATABASE_URL=postgresql://supplify:change_me@postgres:5432/supplify

# ====== KEYCLOAK ======
KEYCLOAK_ADMIN=admin
KEYCLOAK_REALM=Supplify
KEYCLOAK_CLIENT_ID=supplify-api
KEYCLOAK_CLIENT_SECRET=changeme

# ====== MINIO (S3-compatible object storage — not AWS) ======
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me
S3_BUCKET=supplify
# S3_BUCKETS=supplify,supplify-media
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change_me
S3_PUBLIC_READ=true
MINIO_PUBLIC_READ=true

# ====== REDIS ======
REDIS_URL=redis://redis:6379

# ====== PERFORMANCE (API — match deploy/railway/preprod/api.env on Railway) ======
DATABASE_POOL_MAX=20
DATABASE_POOL_IDLE_TIMEOUT_MS=600000
SLOW_REQUEST_MS=800
IDLE_PERF_LOG_MS=500
DB_KEEPALIVE_ENABLED=true
DB_KEEPALIVE_INTERVAL_SECONDS=60

# ====== CRON (in-process jobs: expiry + reorder reminders, scheduled orders, etc.) ======
CRONS_ENABLED=true
# CRON_OPERATIONAL_REMINDERS_INTERVAL_MS=86400000

# ====== EMAIL (transactional notifications) ======
EMAIL_ENABLED=true
EMAIL_PROVIDER=smtp
EMAIL_LOG_ONLY=false
EMAIL_FROM_NAME=Supplify
EMAIL_FROM_ADDRESS=noreply@preprod.example.com
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=change_me
SMTP_FROM=noreply@preprod.example.com
EMAIL_REPLY_TO=support@preprod.example.com
STAFF_PORTAL_BASE_URL=http://localhost

# ====== PORTS ======
BACKEND_PORT=4000
HTTP_PORT=80
KEYCLOAK_PORT=8180

# ====== NODE ======
NODE_ENV=production

# ====== Web Push (VAPID) — npx web-push generate-vapid-keys ======
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=notifications@yourdomain.com

# ====== IMAGES (set automatically by deploy-staging.sh) ======
BACKEND_IMAGE=supplify-backend:staging
FRONTEND_IMAGE=supplify-frontend:staging

# ====== BACKUP (optional — S3-compatible remote storage, not AWS) ======
BACKUP_DIR=/opt/supplify/backups-staging
BACKUP_RETENTION_DAYS=14
BACKUP_STORAGE_BUCKET=
BACKUP_STORAGE_PREFIX=supplify-staging
BACKUP_STORAGE_ENDPOINT=
BACKUP_STORAGE_REGION=
BACKUP_STORAGE_ACCESS_KEY_ID=
BACKUP_STORAGE_SECRET_ACCESS_KEY=

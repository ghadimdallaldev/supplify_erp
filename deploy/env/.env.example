# ====== REQUIRED ======
POSTGRES_PASSWORD=change_me
SESSION_SECRET=change_me

# ====== DATABASE ======
POSTGRES_DB=supplify
POSTGRES_USER=supplify
# For backend use service name "postgres" inside docker network:
DATABASE_URL=postgresql://supplify:change_me@postgres:5432/supplify

# ====== PUBLIC URL (EC2 / production) ======
PUBLIC_URL=http://localhost
VITE_API_URL=http://localhost
WEB_ORIGIN=http://localhost

# ====== APP PORTS (internal container ports) ======
BACKEND_PORT=4000
HTTP_PORT=80

# ====== IMAGES (built by deploy/ec2/deploy.sh) ======
BACKEND_IMAGE=supplify-backend:prod
FRONTEND_IMAGE=supplify-frontend:prod

# ====== BACKUP SETTINGS ======
BACKUP_RETENTION_DAYS=14

# Optional S3 upload
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=supplify
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Keycloak — Railway development (sync: pnpm railway:keycloak:sync -- development)

KEYCLOAK_ADMIN=admin
KC_HOSTNAME=keycloak-development-4942.up.railway.app
KC_PROXY_HEADERS=xforwarded
KC_HOSTNAME_STRICT=false
KC_HOSTNAME_STRICT_HTTPS=false
KC_HTTP_ENABLED=true
KC_HEALTH_ENABLED=true
KC_METRICS_ENABLED=false

# Do NOT set KC_DB or KC_PROXY on Railway — db vendor is build-time; proxy is KC_PROXY_HEADERS only.
# Remove legacy KC_PROXY=edge and KC_DB=postgres from dashboard if present.
PGHOST=${{Postgres-dev.PGHOST}}
PGPORT=${{Postgres-dev.PGPORT}}
PGUSER=${{Postgres-dev.PGUSER}}
PGPASSWORD=${{Postgres-dev.PGPASSWORD}}

# Hard JVM cap — prevents unbounded heap growth (Railway saw 7–10 GB before OOM/restart)
JAVA_OPTS_APPEND=-Xms128m -Xmx512m -XX:MaxMetaspaceSize=192m -XX:+UseContainerSupport -XX:+ExitOnOutOfMemoryError
KC_LOG_LEVEL=warn
KC_HTTP_ACCESS_LOG_ENABLED=false

# Deploy: deploy/railway/development/keycloak/railway.json (GitHub source, Root Directory empty)
# Start: railway-entrypoint.sh start --optimized --import-realm (NOT start-dev)
# Secrets: KEYCLOAK_ADMIN_PASSWORD (same on API) — pass when running railway:keycloak:sync

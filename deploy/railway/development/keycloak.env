# Keycloak — Railway development (paste into Keycloak service Raw Editor; not auto-loaded by image)

KEYCLOAK_ADMIN=admin
# Public hostname (no scheme). Required behind Railway TLS — without this, /admin and token endpoints return "HTTPS required".
KC_HOSTNAME=keycloak-development-4942.up.railway.app
KC_PROXY=edge
KC_PROXY_HEADERS=xforwarded
KC_HOSTNAME_STRICT=false
KC_HOSTNAME_STRICT_HTTPS=false
KC_HTTP_ENABLED=true

# Start command (Settings → Deploy) — must use Dockerfile that copies the realm file:
#   /opt/keycloak/bin/kc.sh start-dev --import-realm
# Build: deploy/railway/keycloak/Dockerfile via development/keycloak/railway.json
# Do NOT use the stock quay.io/keycloak image alone — import folder would be empty.

# Keycloak — Railway development (paste into Keycloak service Raw Editor; not auto-loaded by image)

KEYCLOAK_ADMIN=admin
# Public hostname (no scheme). Required behind Railway TLS — without this, /admin and token endpoints return "HTTPS required".
KC_HOSTNAME=keycloak-development-4942.up.railway.app
KC_PROXY=edge
KC_PROXY_HEADERS=xforwarded
KC_HOSTNAME_STRICT=false
KC_HOSTNAME_STRICT_HTTPS=false
KC_HTTP_ENABLED=true

# --- Memory (Railway dev is often 512 MiB–1 GiB) ---
# Explicit heap cap for 512 MiB plans; leaves headroom for metaspace/native off-heap.
# If your Keycloak service has 1 GiB+, you may switch to:
#   JAVA_OPTS_APPEND=-XX:MaxRAMPercentage=60 -XX:InitialRAMPercentage=25 -XX:+UseContainerSupport -XX:+ExitOnOutOfMemoryError
JAVA_OPTS_APPEND=-Xms128m -Xmx384m -XX:+UseContainerSupport -XX:+ExitOnOutOfMemoryError

# Quieter logs (runtime; does not affect auth)
KC_LOG_LEVEL=warn
KC_HTTP_ACCESS_LOG_ENABLED=false

# Metrics disabled at image build (development/keycloak/railway.json KC_METRICS_ENABLED=false).
# Health stays enabled for Railway deploy healthcheck (/health/ready).

# Start command (Settings → Deploy) — optimized build + start (NOT start-dev):
#   /opt/keycloak/bin/kc.sh start --import-realm
# Build: deploy/railway/keycloak/Dockerfile via development/keycloak/railway.json (KC_PRODUCTION=true)
# Do NOT use the stock quay.io/keycloak image alone — import folder would be empty.

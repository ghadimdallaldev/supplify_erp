{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy/railway/keycloak/Dockerfile",
    "buildArgs": {
      "REALM_EXPORT_FILE": "deploy/keycloak/realm-export.json",
      "REALM_IMPORT_FILENAME": "Supplify-realm.json",
      "KC_PRODUCTION": "false"
    },
    "watchPatterns": ["deploy/keycloak/**", "deploy/railway/keycloak/**"]
  },
  "deploy": {
    "startCommand": "/opt/keycloak/bin/kc.sh start-dev --import-realm",
    "healthcheckPath": "/health/ready",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}

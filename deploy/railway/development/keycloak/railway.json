{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy/railway/development/keycloak/Dockerfile",
    "watchPatterns": ["deploy/keycloak/**", "deploy/railway/development/keycloak/**"]
  },
  "deploy": {
    "startCommand": "/opt/keycloak/bin/kc.sh start-dev --import-realm",
    "healthcheckPath": "/health/ready",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}

# Supplify Web — Railway development (baked into Vite build via Dockerfile)

VITE_APP_ENV=dev
# Unset VITE_API_URL so the SPA uses same-origin /api and /auth (nginx proxy below).
# Cross-host cookies break mobile Chrome login even with SameSite=None.
NGINX_API_UPSTREAM=https://api-dev.supplifyerp.com
VITE_PUBLIC_FRONTEND_URL=https://app-dev.supplifyerp.com

VITE_AUTH_PROVIDER=keycloak
VITE_KEYCLOAK_URL=https://keycloak-dev.supplifyerp.com
VITE_KEYCLOAK_REALM=Supplify
VITE_KEYCLOAK_CLIENT_ID=supplify-web

VITE_PAYMENTS_MODE=mock
VITE_PAYMENTS_PUBLIC_KEY=

VITE_ENABLE_DEBUG_UI=true
VITE_ENABLE_DEMO_BANNERS=true
VITE_ENABLE_MOCK_PAYMENTS=true
VITE_ENABLE_TEST_DATA=true

VITE_SENTRY_ENVIRONMENT=dev

# Delivery GPS (optional map embed — add VITE_GOOGLE_MAPS_API_KEY via dashboard override to rebuild web)
VITE_GPS_TRACKING_ENABLED=true
VITE_GPS_UPDATE_INTERVAL_SECONDS=15
VITE_MAP_PROVIDER=google

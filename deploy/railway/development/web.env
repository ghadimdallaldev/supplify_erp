# Supplify Web — Railway development (baked into Vite build via Dockerfile)

VITE_APP_ENV=dev
VITE_API_URL=https://supplify-api-dev-development.up.railway.app
VITE_PUBLIC_FRONTEND_URL=https://supplify-web-dev-development.up.railway.app

VITE_AUTH_PROVIDER=keycloak
VITE_KEYCLOAK_URL=https://keycloak-development-4942.up.railway.app
VITE_KEYCLOAK_REALM=Supplify
VITE_KEYCLOAK_CLIENT_ID=supplify-web

VITE_PAYMENTS_MODE=mock
VITE_PAYMENTS_PUBLIC_KEY=

VITE_ENABLE_DEBUG_UI=true
VITE_ENABLE_DEMO_BANNERS=true
VITE_ENABLE_MOCK_PAYMENTS=true
VITE_ENABLE_TEST_DATA=true

VITE_SENTRY_ENVIRONMENT=dev

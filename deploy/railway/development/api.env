# Supplify API — Railway development (auto-loaded in container; do not commit secrets)
# Secrets: see secrets.env.example → Railway Raw Editor

APP_ENV=dev
NODE_ENV=development

DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false

WEB_ORIGIN=https://supplify-web-dev-development.up.railway.app
WEB_ORIGINS=https://supplify-web-dev-development.up.railway.app
CORS_ORIGIN=https://supplify-web-dev-development.up.railway.app
PUBLIC_FRONTEND_URL=https://supplify-web-dev-development.up.railway.app
PUBLIC_API_URL=https://supplify-api-dev-development.up.railway.app
API_PUBLIC_URL=https://supplify-api-dev-development.up.railway.app

COOKIE_SECURE=true
# Web + API on different *.up.railway.app hosts — lax blocks cross-origin fetch /auth/me
COOKIE_SAME_SITE=none
TRUST_PROXY=true

AUTH_PROVIDER=keycloak
KEYCLOAK_URL=https://keycloak-development-4942.up.railway.app
KEYCLOAK_PUBLIC_URL=https://keycloak-development-4942.up.railway.app
KEYCLOAK_REALM=Supplify
KEYCLOAK_CLIENT_ID=supplify-api
KEYCLOAK_ADMIN=admin

# Object storage: add a Railway Bucket in this environment (see secrets.env.example)
STORAGE_DRIVER=s3
STORAGE_PUBLIC_READ=false

PAYMENTS_MODE=mock
BILLING_GATEWAY=stub

LOG_LEVEL=debug
ENABLE_REQUEST_LOGGING=true
ENABLE_SWAGGER=true
ENABLE_DEBUG_ROUTES=true
ENABLE_SEED_ROUTES=true
RATE_LIMIT_ENABLED=false
RUN_MIGRATIONS_ON_START=false
ALLOW_DB_RESET=true
SEED_DEMO_DATA=true

SMTP_HOST=localhost
SMTP_PORT=1025

SENTRY_ENVIRONMENT=dev

# In-process cron jobs (Postgres advisory locks; safe with multiple API replicas)
CRONS_ENABLED=true
# Optional override (default 300000 ms / 5 min when NODE_ENV=development)
# CRON_SCHEDULED_ORDERS_INTERVAL_MS=300000

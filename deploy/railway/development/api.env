# Supplify API — Railway development (auto-loaded in container; do not commit secrets)
# Secrets: see secrets.env.example → Railway Raw Editor

APP_ENV=dev
NODE_ENV=development

DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false

WEB_ORIGIN=https://app-dev.supplifyerp.com
WEB_ORIGINS=https://app-dev.supplifyerp.com,https://supplify-web-dev-development.up.railway.app
CORS_ORIGIN=https://app-dev.supplifyerp.com
PUBLIC_FRONTEND_URL=https://app-dev.supplifyerp.com
PUBLIC_API_URL=https://api-dev.supplifyerp.com
API_PUBLIC_URL=https://api-dev.supplifyerp.com
# OAuth callback must land first-party on the WEB host (cookies then aren't third-party,
# so mobile Chrome keeps them). Behind the nginx same-origin proxy the API receives
# Host = API host, so force the callback origin here. See callbackOrigin() in auth.routes.js.
OAUTH_CALLBACK_BASE_URL=https://app-dev.supplifyerp.com
STAFF_PORTAL_BASE_URL=https://app-dev.supplifyerp.com

COOKIE_SECURE=true
# Web + API on different *.up.railway.app hosts — lax blocks cross-origin fetch /auth/me
COOKIE_SAME_SITE=none
TRUST_PROXY=true

AUTH_PROVIDER=keycloak
# Server-side Keycloak calls (token, userinfo, admin API). Browser redirects use KEYCLOAK_PUBLIC_URL below.
# Optional dashboard override for private networking (same Railway env): set KEYCLOAK_URL to
# http://${{Keycloak-dev.RAILWAY_PRIVATE_DOMAIN}}:8080 — keep KEYCLOAK_PUBLIC_URL on the public hostname.
KEYCLOAK_URL=https://keycloak-dev.supplifyerp.com
KEYCLOAK_PUBLIC_URL=https://keycloak-dev.supplifyerp.com
KEYCLOAK_REALM=Supplify
KEYCLOAK_CLIENT_ID=supplify-api
KEYCLOAK_ADMIN=admin

# Object storage: add a Railway Bucket in this environment (see secrets.env.example)
STORAGE_DRIVER=s3
STORAGE_PUBLIC_READ=false

PAYMENTS_MODE=mock
BILLING_GATEWAY=stub

LOG_LEVEL=debug
ENABLE_REQUEST_LOGGING=true
ENABLE_SWAGGER=true
ENABLE_DEBUG_ROUTES=true
ENABLE_SEED_ROUTES=true
RATE_LIMIT_ENABLED=false
RUN_MIGRATIONS_ON_START=true
ALLOW_DB_RESET=true
SEED_DEMO_DATA=true

EMAIL_ENABLED=true
EMAIL_PROVIDER=smtp
EMAIL_LOG_ONLY=true
EMAIL_FROM_NAME=Supplify
EMAIL_FROM_ADDRESS=no-reply@supplify.local

SENTRY_ENVIRONMENT=dev

# In-process cron jobs (Postgres advisory locks; safe with multiple API replicas)
CRONS_ENABLED=true
# Optional override (default 300000 ms / 5 min when NODE_ENV=development)
# CRON_SCHEDULED_ORDERS_INTERVAL_MS=300000
# Optional override (default 86400000 ms / 24 h) — expiry + reorder cadence reminders
# CRON_OPERATIONAL_REMINDERS_INTERVAL_MS=86400000

# Delivery GPS / live tracking (migration 0137)
GPS_TRACKING_ENABLED=true
GPS_STALE_AFTER_SECONDS=300
GPS_UPDATE_INTERVAL_SECONDS=15
GPS_MIN_ACCURACY_METERS=100
GPS_LOCATION_RETENTION_DAYS=90
GPS_ALLOW_RESTAURANT_LIVE_TRACKING=true
GPS_RESTAURANT_SHOW_DRIVER_NAME=true
GPS_RESTAURANT_SHOW_DRIVER_PHONE=false
GPS_ALLOW_DRIVER_BACKGROUND_HINT=true
DELIVERY_ETA_CITY_SPEED_KMH=20
DELIVERY_ETA_MIN_MULTIPLIER=1.0
DELIVERY_ETA_MAX_MULTIPLIER=1.5
DELIVERY_ETA_SERVICE_TIME_MINUTES=5
MAP_PROVIDER=google
# GOOGLE_MAPS_API_KEY=  # optional server map helper — set in dashboard if needed

# Web Push (VAPID) — set VAPID_* in Railway API secrets (see secrets.env.example)
# Without these, restaurant Settings shows "Push is not configured on this server."

# --- Performance: pool, keepalive, Redis-backed cache (set REDIS_URL in secrets.env.example) ---
DATABASE_POOL_MAX=20
DATABASE_POOL_IDLE_TIMEOUT_MS=600000
SLOW_REQUEST_MS=800
IDLE_PERF_LOG_MS=500
DB_KEEPALIVE_ENABLED=true
DB_KEEPALIVE_INTERVAL_SECONDS=60

# WhatsApp notifications (secrets: WHATSAPP_ACCESS_TOKEN, WHATSAPP_PHONE_NUMBER_ID)
WHATSAPP_ENABLED=false
WHATSAPP_LOG_ONLY=true
WHATSAPP_API_VERSION=v21.0

# Paste into Railway Raw Editor per service. Replace CHANGE_ME. Do not commit real values.
# Do NOT set PORT — Railway injects it; forcing PORT=4000 often causes 502.
# Do NOT paste api.env / web.env here — those load from git on deploy.

# ── API service (secrets only — everything else is in development/api.env) ───
DATABASE_URL=${{Postgres-dev.DATABASE_URL}}
SESSION_SECRET=CHANGE_ME
IMPERSONATION_SECRET=CHANGE_ME
KEYCLOAK_CLIENT_SECRET=CHANGE_ME
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# ── Keycloak service ──────────────────────────────────────────────────────────
# KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

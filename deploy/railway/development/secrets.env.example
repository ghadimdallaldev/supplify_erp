# Paste into Railway Raw Editor per service. Replace CHANGE_ME. Do not commit real values.
# Do NOT set PORT — Railway injects it; forcing PORT=4000 often causes 502.
# Do NOT paste api.env / web.env here — those load from git on deploy.

# ── API service (secrets only — everything else is in development/api.env) ───
DATABASE_URL=${{Postgres-dev.DATABASE_URL}}
# Private Redis only (same Railway environment). Do NOT use REDIS_PUBLIC_URL on API (egress fees).
# Required for middleware/entitlements cache (see development/api.env performance vars).
REDIS_URL=${{redis-dev.REDIS_URL}}

# Storage Bucket: + New → Bucket, then on API service Variables → "Add variable references" → AWS SDK preset,
# OR paste manually (replace supplify-storage-dev with your bucket service name):
# STORAGE_ENDPOINT=${{supplify-storage-dev.ENDPOINT}}
# STORAGE_BUCKET=${{supplify-storage-dev.BUCKET}}
# STORAGE_ACCESS_KEY_ID=${{supplify-storage-dev.ACCESS_KEY_ID}}
# STORAGE_SECRET_ACCESS_KEY=${{supplify-storage-dev.SECRET_ACCESS_KEY}}
# STORAGE_REGION=${{supplify-storage-dev.REGION}}

SESSION_SECRET=CHANGE_ME
IMPERSONATION_SECRET=CHANGE_ME
# Must match Keycloak → supplify-api → Credentials (import default: changeme)
KEYCLOAK_CLIENT_SECRET=changeme
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# Email — only SMTP_PASS needed when overriding EMAIL_LOG_ONLY=false for real sends
# Optional: EMAIL_TEST_TO=you@example.com for pnpm email:test in dev
SMTP_PASS=CHANGE_ME

# ── Keycloak service ──────────────────────────────────────────────────────────
# KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

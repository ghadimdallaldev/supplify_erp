# Keycloak — Railway staging (sync: pnpm railway:keycloak:sync -- staging)

KEYCLOAK_ADMIN=admin
KC_HOSTNAME=keycloak-staging.example.com
KC_PROXY=edge
KC_PROXY_HEADERS=xforwarded
KC_HOSTNAME_STRICT=false
KC_HOSTNAME_STRICT_HTTPS=false
KC_HTTP_ENABLED=true

PGHOST=${{Postgres-staging.PGHOST}}
PGPORT=${{Postgres-staging.PGPORT}}
PGUSER=${{Postgres-staging.PGUSER}}
PGPASSWORD=${{Postgres-staging.PGPASSWORD}}

JAVA_OPTS_APPEND=-Xms128m -Xmx384m -XX:+UseContainerSupport -XX:+ExitOnOutOfMemoryError
KC_LOG_LEVEL=warn
KC_HTTP_ACCESS_LOG_ENABLED=false

# Deploy: deploy/railway/staging/keycloak/railway.json (GitHub source, Root Directory empty)
# Secrets: KEYCLOAK_ADMIN_PASSWORD (same on API) — pass when running railway:keycloak:sync

# Keycloak — Railway staging (same realm as preprod: supplify-preprod)
# Paste into Keycloak service Raw Editor when the Railway environment is named "staging".

KEYCLOAK_ADMIN=admin
KC_HOSTNAME=keycloak-staging.example.com
KC_PROXY=edge
KC_PROXY_HEADERS=xforwarded
KC_HOSTNAME_STRICT=false
KC_HOSTNAME_STRICT_HTTPS=false
KC_HTTP_ENABLED=true

# Build: deploy/railway/keycloak/Dockerfile via staging/keycloak/railway.json
# Start: /opt/keycloak/bin/kc.sh start-dev --import-realm
# Setup: deploy/railway/keycloak/RAILWAY_SETUP.md

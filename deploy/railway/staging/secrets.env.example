# Paste into Railway staging service variables (never commit real secrets).
# Private REDIS_URL only — not REDIS_PUBLIC_URL (egress on API). Required for API cache TTLs.
REDIS_URL=${{redis-staging.REDIS_URL}}
# Web Push — pnpm vapid:generate && pnpm railway:vapid:sync -- staging
VAPID_PUBLIC_KEY=CHANGE_ME
VAPID_PRIVATE_KEY=CHANGE_ME
VAPID_EMAIL=notifications@staging.example.com

# Supplify API — Railway preprod (auto-loaded; secrets in secrets.env.example)

APP_ENV=preprod
NODE_ENV=production

DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false

WEB_ORIGIN=https://supplify-web-preprod.up.railway.app
WEB_ORIGINS=https://supplify-web-preprod.up.railway.app
CORS_ORIGIN=https://supplify-web-preprod.up.railway.app
PUBLIC_FRONTEND_URL=https://supplify-web-preprod.up.railway.app
PUBLIC_API_URL=https://supplify-api-preprod.up.railway.app
API_PUBLIC_URL=https://supplify-api-preprod.up.railway.app

COOKIE_SECURE=true
COOKIE_SAME_SITE=none
TRUST_PROXY=true

AUTH_PROVIDER=keycloak
KEYCLOAK_URL=https://keycloak-preprod.example.com
KEYCLOAK_PUBLIC_URL=https://keycloak-preprod.example.com
KEYCLOAK_REALM=supplify-preprod
KEYCLOAK_CLIENT_ID=supplify-api
KEYCLOAK_ADMIN=admin

STORAGE_DRIVER=s3

PAYMENTS_MODE=test
BILLING_GATEWAY=stub

LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true
ENABLE_SWAGGER=false
ENABLE_DEBUG_ROUTES=false
ENABLE_SEED_ROUTES=false
RATE_LIMIT_ENABLED=true
RUN_MIGRATIONS_ON_START=false
ALLOW_DB_RESET=false
SEED_DEMO_DATA=false

EMAIL_PROVIDER=sendgrid

SENTRY_ENVIRONMENT=preprod

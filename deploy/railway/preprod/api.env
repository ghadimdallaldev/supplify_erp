# Supplify API — Railway preprod (auto-loaded; secrets in secrets.env.example)

APP_ENV=preprod
NODE_ENV=production

DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false

WEB_ORIGIN=https://app-preprod.supplifyerp.com
WEB_ORIGINS=https://app-preprod.supplifyerp.com
CORS_ORIGIN=https://app-preprod.supplifyerp.com
PUBLIC_FRONTEND_URL=https://app-preprod.supplifyerp.com
PUBLIC_API_URL=https://api-preprod.supplifyerp.com
API_PUBLIC_URL=https://api-preprod.supplifyerp.com
OAUTH_CALLBACK_BASE_URL=https://app-preprod.supplifyerp.com
STAFF_PORTAL_BASE_URL=https://app-preprod.supplifyerp.com

COOKIE_SECURE=true
COOKIE_SAME_SITE=none
COOKIE_DOMAIN=.supplifyerp.com
TRUST_PROXY=true

AUTH_PROVIDER=keycloak
KEYCLOAK_URL=https://keycloak-preprod.supplifyerp.com
KEYCLOAK_PUBLIC_URL=https://keycloak-preprod.supplifyerp.com
KEYCLOAK_REALM=supplify-preprod
KEYCLOAK_CLIENT_ID=supplify-api
KEYCLOAK_ADMIN=admin

STORAGE_DRIVER=s3
STORAGE_PUBLIC_READ=false

PAYMENTS_MODE=test
BILLING_GATEWAY=stub

LOG_LEVEL=warn
ENABLE_REQUEST_LOGGING=false
ENABLE_SWAGGER=false
ENABLE_DEBUG_ROUTES=false
ENABLE_SEED_ROUTES=false
RATE_LIMIT_ENABLED=true
RUN_MIGRATIONS_ON_START=true
ALLOW_DB_RESET=false
SEED_DEMO_DATA=false

EMAIL_ENABLED=true
EMAIL_PROVIDER=smtp
EMAIL_LOG_ONLY=true
EMAIL_FROM_NAME=Supplify
EMAIL_FROM_ADDRESS=noreply@preprod.supplifyerp.com
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_FROM=noreply@preprod.supplifyerp.com

SENTRY_ENVIRONMENT=preprod

CRONS_ENABLED=true

GPS_TRACKING_ENABLED=true
GPS_STALE_AFTER_SECONDS=300
GPS_UPDATE_INTERVAL_SECONDS=15
GPS_MIN_ACCURACY_METERS=100
GPS_LOCATION_RETENTION_DAYS=90
GPS_ALLOW_RESTAURANT_LIVE_TRACKING=true
GPS_RESTAURANT_SHOW_DRIVER_NAME=true
GPS_RESTAURANT_SHOW_DRIVER_PHONE=false
GPS_ALLOW_DRIVER_BACKGROUND_HINT=true
MAP_PROVIDER=google

DATABASE_POOL_MAX=20
DATABASE_POOL_IDLE_TIMEOUT_MS=600000
SLOW_REQUEST_MS=800
IDLE_PERF_LOG_MS=500
DB_KEEPALIVE_ENABLED=true
DB_KEEPALIVE_INTERVAL_SECONDS=60

# Preprod API — Railway Raw Editor only (replace CHANGE_ME; never use dev secrets)

DATABASE_URL=${{Postgres-preprod.DATABASE_URL}}
REDIS_URL=${{redis-preprod.REDIS_URL}}
SESSION_SECRET=CHANGE_ME
IMPERSONATION_SECRET=CHANGE_ME
KEYCLOAK_CLIENT_SECRET=CHANGE_ME
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# Railway Bucket (recommended): use ${{your-bucket.ENDPOINT}} etc., or Cloudflare R2:
STORAGE_ENDPOINT=https://your-account.r2.cloudflarestorage.com
STORAGE_PUBLIC_URL=https://pub-preprod.example.com
STORAGE_BUCKET=supplify-preprod
STORAGE_ACCESS_KEY_ID=CHANGE_ME
STORAGE_SECRET_ACCESS_KEY=CHANGE_ME
STORAGE_REGION=auto

SENDGRID_API_KEY=CHANGE_ME
SENDGRID_FROM_EMAIL=noreply@preprod.example.com
PAYMENTS_WEBHOOK_SECRET=CHANGE_WHEN_TESTING_WEBHOOKS

# Supplify Web — Railway preprod (Docker build via RAILWAY_DEPLOY_ENV=preprod)

VITE_APP_ENV=preprod
# Same-origin /api and /auth via nginx (first-party cookies on app-preprod.supplifyerp.com)
NGINX_API_UPSTREAM=https://api-preprod.supplifyerp.com
VITE_PUBLIC_FRONTEND_URL=https://app-preprod.supplifyerp.com

VITE_AUTH_PROVIDER=keycloak
VITE_KEYCLOAK_URL=https://keycloak-preprod.supplifyerp.com
VITE_KEYCLOAK_REALM=supplify-preprod
VITE_KEYCLOAK_CLIENT_ID=supplify-web

VITE_PAYMENTS_MODE=test
VITE_PAYMENTS_PUBLIC_KEY=

VITE_ENABLE_DEBUG_UI=false
VITE_ENABLE_DEMO_BANNERS=true
VITE_ENABLE_MOCK_PAYMENTS=false
VITE_ENABLE_TEST_DATA=false

VITE_SENTRY_ENVIRONMENT=preprod

VITE_GPS_TRACKING_ENABLED=true
VITE_GPS_UPDATE_INTERVAL_SECONDS=15
VITE_MAP_PROVIDER=google

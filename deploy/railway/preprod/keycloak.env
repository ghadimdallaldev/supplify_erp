# Keycloak — Railway preprod (sync: pnpm railway:keycloak:sync -- preprod)

KEYCLOAK_ADMIN=admin
KC_HOSTNAME=keycloak-preprod.supplifyerp.com
KC_PROXY_HEADERS=xforwarded
KC_HOSTNAME_STRICT=false
KC_HOSTNAME_STRICT_HTTPS=false
KC_HTTP_ENABLED=true
KC_HEALTH_ENABLED=true
KC_METRICS_ENABLED=false

PGHOST=${{Postgres.PGHOST}}
PGPORT=${{Postgres.PGPORT}}
PGUSER=${{Postgres.PGUSER}}
PGPASSWORD=${{Postgres.PGPASSWORD}}

JAVA_OPTS_APPEND=-Xms128m -Xmx512m -XX:MaxMetaspaceSize=192m -XX:+UseContainerSupport -XX:+ExitOnOutOfMemoryError
KC_LOG_LEVEL=warn
KC_HTTP_ACCESS_LOG_ENABLED=false

KEYCLOAK_USE_OPTIMIZED=false

# Email OTP — secrets SUPPLIFY_OTP_MAIL_SECRET + AUTH_EMAIL_OTP_HMAC_SECRET in Railway dashboard
AUTH_EMAIL_OTP_ENABLED=true
AUTH_EMAIL_OTP_DRIVER_BYPASS=true
SUPPLIFY_OTP_MAIL_URL=https://api-preprod.supplifyerp.com/api/internal/auth/otp/email

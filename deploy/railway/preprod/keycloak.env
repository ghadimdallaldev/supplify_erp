# Keycloak — Railway preprod (sync: pnpm railway:keycloak:sync -- preprod)

KEYCLOAK_ADMIN=admin
KC_HOSTNAME=keycloak-preprod.example.com
KC_PROXY=edge
KC_PROXY_HEADERS=xforwarded
KC_HOSTNAME_STRICT=false
KC_HOSTNAME_STRICT_HTTPS=false
KC_HTTP_ENABLED=true

PGHOST=${{Postgres-preprod.PGHOST}}
PGPORT=${{Postgres-preprod.PGPORT}}
PGUSER=${{Postgres-preprod.PGUSER}}
PGPASSWORD=${{Postgres-preprod.PGPASSWORD}}

# Deploy: deploy/railway/preprod/keycloak/railway.json

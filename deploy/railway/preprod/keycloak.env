# Keycloak — Railway preprod (sync: pnpm railway:keycloak:sync -- preprod)

KEYCLOAK_ADMIN=admin
KC_HOSTNAME=keycloak-preprod.example.com
KC_PROXY_HEADERS=xforwarded
KC_HOSTNAME_STRICT=false
KC_HOSTNAME_STRICT_HTTPS=false
KC_HTTP_ENABLED=true
KC_HEALTH_ENABLED=true
KC_METRICS_ENABLED=false

# Do NOT set KC_DB or KC_PROXY on Railway — db vendor is build-time; proxy is KC_PROXY_HEADERS only.
PGHOST=${{Postgres-preprod.PGHOST}}
PGPORT=${{Postgres-preprod.PGPORT}}
PGUSER=${{Postgres-preprod.PGUSER}}
PGPASSWORD=${{Postgres-preprod.PGPASSWORD}}

JAVA_OPTS_APPEND=-Xms128m -Xmx512m -XX:MaxMetaspaceSize=192m -XX:+UseContainerSupport -XX:+ExitOnOutOfMemoryError
KC_LOG_LEVEL=warn
KC_HTTP_ACCESS_LOG_ENABLED=false

# Deploy: deploy/railway/preprod/keycloak/railway.json (GitHub source, Root Directory empty)
# Non-prod: runtime postgres start (same as dev — reliable on Railway).
KEYCLOAK_USE_OPTIMIZED=false
# Secrets: KEYCLOAK_ADMIN_PASSWORD (same on API) — pass when running railway:keycloak:sync

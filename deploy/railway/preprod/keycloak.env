# Keycloak — Railway preprod (paste into Keycloak service Raw Editor)

KEYCLOAK_ADMIN=admin
KC_HOSTNAME_STRICT=false
KC_HOSTNAME_STRICT_HTTPS=false
KC_HTTP_ENABLED=true
KC_PROXY=edge

# Start: /opt/keycloak/bin/kc.sh start --import-realm
# Import: deploy/keycloak/realm-export.preprod.json (realm supplify-preprod)

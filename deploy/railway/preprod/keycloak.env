# Keycloak — Railway preprod (paste into Keycloak service Raw Editor)

KEYCLOAK_ADMIN=admin
# Set to your Railway/public hostname (no scheme), e.g. keycloak-preprod.up.railway.app
KC_HOSTNAME=keycloak-preprod.example.com
KC_PROXY=edge
KC_PROXY_HEADERS=xforwarded
KC_HOSTNAME_STRICT=false
KC_HOSTNAME_STRICT_HTTPS=false
KC_HTTP_ENABLED=true

# Build: deploy/railway/keycloak/Dockerfile via preprod/keycloak/railway.json
# Start: /opt/keycloak/bin/kc.sh start-dev --import-realm
# Realm supplify-preprod is baked as /opt/keycloak/data/import/supplify-preprod-realm.json
# Setup: deploy/railway/keycloak/RAILWAY_SETUP.md

# Production API — Railway Raw Editor only (unique secrets per environment)

DATABASE_URL=${{Postgres-prod.DATABASE_URL}}
# Private REDIS_URL only — not REDIS_PUBLIC_URL (egress on API). Required for API cache TTLs.
REDIS_URL=${{redis-prod.REDIS_URL}}
SESSION_SECRET=CHANGE_ME
IMPERSONATION_SECRET=CHANGE_ME
KEYCLOAK_CLIENT_SECRET=CHANGE_ME
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

STORAGE_ENDPOINT=https://your-account.r2.cloudflarestorage.com
STORAGE_PUBLIC_URL=https://cdn.yourdomain.com
STORAGE_BUCKET=supplify-prod
STORAGE_ACCESS_KEY_ID=CHANGE_ME
STORAGE_SECRET_ACCESS_KEY=CHANGE_ME
STORAGE_REGION=auto

SMTP_PASS=CHANGE_ME
# Web Push — unique keys per environment: pnpm vapid:generate && pnpm railway:vapid:sync -- production
VAPID_PUBLIC_KEY=CHANGE_ME
VAPID_PRIVATE_KEY=CHANGE_ME
VAPID_EMAIL=notifications@yourdomain.com
EMAIL_REPLY_TO=support@yourdomain.com
PAYMENTS_PUBLIC_KEY=CHANGE_WHEN_LIVE
PAYMENTS_SECRET_KEY=CHANGE_WHEN_LIVE
PAYMENTS_WEBHOOK_SECRET=CHANGE_WHEN_LIVE

# Keycloak — production (sync: pnpm railway:keycloak:sync -- production)

KEYCLOAK_ADMIN=admin
KC_HOSTNAME=keycloak.yourdomain.com
KC_PROXY_HEADERS=xforwarded
KC_HOSTNAME_STRICT=false
KC_HOSTNAME_STRICT_HTTPS=false
KC_HTTP_ENABLED=true
KC_HEALTH_ENABLED=true
KC_METRICS_ENABLED=true

# Do NOT set KC_DB or KC_PROXY on Railway — db vendor is build-time; proxy is KC_PROXY_HEADERS only.
PGHOST=${{Postgres-prod.PGHOST}}
PGPORT=${{Postgres-prod.PGPORT}}
PGUSER=${{Postgres-prod.PGUSER}}
PGPASSWORD=${{Postgres-prod.PGPASSWORD}}

# Production: percentage-based heap (Railway plan ≥ 2 GiB recommended for Keycloak).
JAVA_OPTS_APPEND=-XX:MaxRAMPercentage=60 -XX:InitialRAMPercentage=25 -XX:MaxMetaspaceSize=256m -XX:+UseContainerSupport -XX:+ExitOnOutOfMemoryError
KC_LOG_LEVEL=warn
KC_HTTP_ACCESS_LOG_ENABLED=false

# Deploy: deploy/railway/production/keycloak/railway.json (GitHub source, Root Directory empty)
# Production: optimized start after Dockerfile postgres build (faster boot, metrics enabled).
KEYCLOAK_USE_OPTIMIZED=true
# Secrets: KEYCLOAK_ADMIN_PASSWORD (same on API) — pass when running railway:keycloak:sync

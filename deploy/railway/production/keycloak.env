# Keycloak — production (sync: pnpm railway:keycloak:sync -- production)

KEYCLOAK_ADMIN=admin
KC_HOSTNAME=keycloak.yourdomain.com
KC_PROXY=edge
KC_PROXY_HEADERS=xforwarded
KC_HOSTNAME_STRICT=false
KC_HOSTNAME_STRICT_HTTPS=false
KC_HTTP_ENABLED=true

PGHOST=${{Postgres-prod.PGHOST}}
PGPORT=${{Postgres-prod.PGPORT}}
PGUSER=${{Postgres-prod.PGUSER}}
PGPASSWORD=${{Postgres-prod.PGPASSWORD}}

JAVA_OPTS_APPEND=-XX:MaxRAMPercentage=60 -XX:InitialRAMPercentage=25 -XX:+UseContainerSupport -XX:+ExitOnOutOfMemoryError
KC_LOG_LEVEL=warn
KC_HTTP_ACCESS_LOG_ENABLED=false

# Deploy: deploy/railway/production/keycloak/railway.json (GitHub source, Root Directory empty)
# Secrets: KEYCLOAK_ADMIN_PASSWORD (same on API) — pass when running railway:keycloak:sync

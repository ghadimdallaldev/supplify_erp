# Keycloak — production (paste into Keycloak service Raw Editor)

KEYCLOAK_ADMIN=admin
# Set to your production hostname (no scheme), e.g. keycloak.yourdomain.com
KC_HOSTNAME=keycloak.yourdomain.com
KC_PROXY=edge
KC_PROXY_HEADERS=xforwarded
KC_HOSTNAME_STRICT=false
KC_HOSTNAME_STRICT_HTTPS=false
KC_HTTP_ENABLED=true

# Build: deploy/railway/keycloak/Dockerfile via production/keycloak/railway.json
# Start: /opt/keycloak/bin/kc.sh start --import-realm
# Realm supplify-prod is baked as /opt/keycloak/data/import/supplify-prod-realm.json
# Setup: deploy/railway/keycloak/RAILWAY_SETUP.md

# Keycloak — production (paste into Keycloak service Raw Editor)

KEYCLOAK_ADMIN=admin
KC_HOSTNAME_STRICT=false
KC_HOSTNAME_STRICT_HTTPS=false
KC_HTTP_ENABLED=true
KC_PROXY=edge

# Production: prefer KC_HOSTNAME=https://keycloak.yourdomain.com when using a custom domain
# Start: /opt/keycloak/bin/kc.sh start --import-realm
# Import: deploy/keycloak/realm-export.prod.json (realm supplify-prod)

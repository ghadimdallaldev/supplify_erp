# Supplify Web — Railway production (Docker build via RAILWAY_DEPLOY_ENV=production)

VITE_APP_ENV=prod
# Same-origin /api and /auth via nginx (first-party cookies on app.supplifyerp.com)
NGINX_API_UPSTREAM=https://api.supplifyerp.com
VITE_PUBLIC_FRONTEND_URL=https://app.supplifyerp.com

VITE_AUTH_PROVIDER=keycloak
VITE_KEYCLOAK_URL=https://keycloak.supplifyerp.com
VITE_KEYCLOAK_REALM=supplify-prod
VITE_KEYCLOAK_CLIENT_ID=supplify-web

VITE_PAYMENTS_MODE=live
VITE_PAYMENTS_PUBLIC_KEY=

VITE_ENABLE_DEBUG_UI=false
VITE_ENABLE_DEMO_BANNERS=false
VITE_ENABLE_MOCK_PAYMENTS=false
VITE_ENABLE_TEST_DATA=false

VITE_SENTRY_ENVIRONMENT=prod

VITE_GPS_TRACKING_ENABLED=true
VITE_GPS_UPDATE_INTERVAL_SECONDS=15
VITE_GPS_TRACKING_SESSIONS_ENABLED=true
VITE_GPS_LIVE_EVENTS_ENABLED=true
VITE_MAP_PROVIDER=google

# Supplify Web — Railway production (Docker build via RAILWAY_DEPLOY_ENV=production)

VITE_APP_ENV=prod
VITE_API_URL=https://api.yourdomain.com
VITE_PUBLIC_FRONTEND_URL=https://app.yourdomain.com

VITE_AUTH_PROVIDER=keycloak
VITE_KEYCLOAK_URL=https://keycloak.yourdomain.com
VITE_KEYCLOAK_REALM=supplify-prod
VITE_KEYCLOAK_CLIENT_ID=supplify-web

VITE_PAYMENTS_MODE=live
VITE_PAYMENTS_PUBLIC_KEY=

VITE_ENABLE_DEBUG_UI=false
VITE_ENABLE_DEMO_BANNERS=false
VITE_ENABLE_MOCK_PAYMENTS=false
VITE_ENABLE_TEST_DATA=false

VITE_SENTRY_ENVIRONMENT=prod

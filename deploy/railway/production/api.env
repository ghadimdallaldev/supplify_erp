# Supplify API — Railway production (auto-loaded; secrets in secrets.env.example)

APP_ENV=prod
NODE_ENV=production

DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false

WEB_ORIGIN=https://app.yourdomain.com
WEB_ORIGINS=https://app.yourdomain.com
CORS_ORIGIN=https://app.yourdomain.com
PUBLIC_FRONTEND_URL=https://app.yourdomain.com
PUBLIC_API_URL=https://api.yourdomain.com
API_PUBLIC_URL=https://api.yourdomain.com
STAFF_PORTAL_BASE_URL=https://app.yourdomain.com

COOKIE_SECURE=true
COOKIE_SAME_SITE=none
TRUST_PROXY=true

AUTH_PROVIDER=keycloak
KEYCLOAK_URL=https://keycloak.yourdomain.com
KEYCLOAK_PUBLIC_URL=https://keycloak.yourdomain.com
KEYCLOAK_REALM=supplify-prod
KEYCLOAK_CLIENT_ID=supplify-api
KEYCLOAK_ADMIN=admin

STORAGE_DRIVER=s3
STORAGE_PUBLIC_READ=false

PAYMENTS_MODE=live
BILLING_GATEWAY=stub

LOG_LEVEL=warn
ENABLE_REQUEST_LOGGING=false
ENABLE_SWAGGER=false
ENABLE_DEBUG_ROUTES=false
ENABLE_SEED_ROUTES=false
RATE_LIMIT_ENABLED=true
RUN_MIGRATIONS_ON_START=true
ALLOW_DB_RESET=false
SEED_DEMO_DATA=false

EMAIL_ENABLED=true
EMAIL_PROVIDER=smtp
EMAIL_LOG_ONLY=false
EMAIL_FROM_NAME=Supplify
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_FROM=noreply@yourdomain.com

SENTRY_ENVIRONMENT=prod

CRONS_ENABLED=true
# Default 3600000 ms / 1 h when NODE_ENV=production
# CRON_SCHEDULED_ORDERS_INTERVAL_MS=3600000
# Default 86400000 ms / 24 h — expiry + reorder cadence reminders
# CRON_OPERATIONAL_REMINDERS_INTERVAL_MS=86400000

GPS_TRACKING_ENABLED=true
GPS_STALE_AFTER_SECONDS=300
GPS_UPDATE_INTERVAL_SECONDS=15
GPS_MIN_ACCURACY_METERS=100
GPS_LOCATION_RETENTION_DAYS=90
GPS_ALLOW_RESTAURANT_LIVE_TRACKING=true
GPS_RESTAURANT_SHOW_DRIVER_NAME=true
GPS_RESTAURANT_SHOW_DRIVER_PHONE=false
GPS_ALLOW_DRIVER_BACKGROUND_HINT=true
MAP_PROVIDER=google

# --- Performance: pool, keepalive, Redis-backed cache (set REDIS_URL in secrets.env.example) ---
DATABASE_POOL_MAX=20
DATABASE_POOL_IDLE_TIMEOUT_MS=600000
SLOW_REQUEST_MS=800
IDLE_PERF_LOG_MS=0
DB_KEEPALIVE_ENABLED=true
DB_KEEPALIVE_INTERVAL_SECONDS=60

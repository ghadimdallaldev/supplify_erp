# Supplify API — Railway production (auto-loaded; secrets in secrets.env.example)

APP_ENV=prod
NODE_ENV=production

DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false

WEB_ORIGIN=https://app.supplifyerp.com
WEB_ORIGINS=https://app.supplifyerp.com
CORS_ORIGIN=https://app.supplifyerp.com
PUBLIC_FRONTEND_URL=https://app.supplifyerp.com
PUBLIC_API_URL=https://api.supplifyerp.com
API_PUBLIC_URL=https://api.supplifyerp.com
OAUTH_CALLBACK_BASE_URL=https://app.supplifyerp.com
STAFF_PORTAL_BASE_URL=https://app.supplifyerp.com

COOKIE_SECURE=true
COOKIE_SAME_SITE=none
COOKIE_DOMAIN=.supplifyerp.com
TRUST_PROXY=true

AUTH_PROVIDER=keycloak
KEYCLOAK_URL=https://keycloak.supplifyerp.com
KEYCLOAK_PUBLIC_URL=https://keycloak.supplifyerp.com
KEYCLOAK_REALM=supplify-prod
KEYCLOAK_CLIENT_ID=supplify-api
KEYCLOAK_ADMIN=admin

STORAGE_DRIVER=s3
STORAGE_PUBLIC_READ=false

PAYMENTS_MODE=live
# Pilot / controlled launch: manual ledger charges only (never stub under live)
BILLING_GATEWAY=manual

LOG_LEVEL=warn
ENABLE_REQUEST_LOGGING=false
ENABLE_SWAGGER=false
ENABLE_DEBUG_ROUTES=false
ENABLE_SEED_ROUTES=false
RATE_LIMIT_ENABLED=true
RUN_MIGRATIONS_ON_START=true
ALLOW_DB_RESET=false
SEED_DEMO_DATA=false

EMAIL_ENABLED=true
EMAIL_PROVIDER=smtp
EMAIL_LOG_ONLY=false
EMAIL_FROM_NAME=Supplify
EMAIL_FROM_ADDRESS=noreply@supplifyerp.com
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_FROM=noreply@supplifyerp.com

# Email OTP (secret: AUTH_EMAIL_OTP_INTERNAL_SECRET in Railway dashboard)
AUTH_EMAIL_OTP_ENABLED=true
AUTH_EMAIL_OTP_LENGTH=6
AUTH_EMAIL_OTP_TTL_SECONDS=600
AUTH_EMAIL_OTP_MAX_ATTEMPTS=5
AUTH_EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60
AUTH_EMAIL_OTP_SEND_WINDOW_MS=3600000
AUTH_EMAIL_OTP_SEND_MAX=10

SENTRY_ENVIRONMENT=prod

CRONS_ENABLED=true

GPS_TRACKING_ENABLED=true
GPS_STALE_AFTER_SECONDS=300
GPS_UPDATE_INTERVAL_SECONDS=15
GPS_MIN_ACCURACY_METERS=100
GPS_LOCATION_RETENTION_DAYS=90
GPS_ALLOW_RESTAURANT_LIVE_TRACKING=true
GPS_RESTAURANT_SHOW_DRIVER_NAME=true
GPS_RESTAURANT_SHOW_DRIVER_PHONE=false
GPS_ALLOW_DRIVER_BACKGROUND_HINT=true
# Driver tracking sessions / live socket events (migration 0194)
GPS_TRACKING_SESSIONS_ENABLED=true
GPS_LIVE_EVENTS_ENABLED=true
GPS_OFFLINE_QUEUE_ENABLED=true
MAP_PROVIDER=google

DATABASE_POOL_MAX=20
DATABASE_POOL_IDLE_TIMEOUT_MS=600000
SLOW_REQUEST_MS=800
IDLE_PERF_LOG_MS=0
DB_KEEPALIVE_ENABLED=true
DB_KEEPALIVE_INTERVAL_SECONDS=60

# WhatsApp notifications (secrets: WHATSAPP_ACCESS_TOKEN, WHATSAPP_PHONE_NUMBER_ID,
# WHATSAPP_WEBHOOK_VERIFY_TOKEN, WHATSAPP_APP_SECRET)
# Meta callback URL: https://api.supplifyerp.com/webhooks/whatsapp
WHATSAPP_ENABLED=false
WHATSAPP_LOG_ONLY=true
WHATSAPP_API_VERSION=v21.0

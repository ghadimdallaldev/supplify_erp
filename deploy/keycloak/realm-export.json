{
  "realm": "Supplify",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "rememberMe": false,
  "accessTokenLifespan": 1200,
  "accessTokenLifespanForImplicitFlow": 1200,
  "ssoSessionIdleTimeout": 604800,
  "ssoSessionMaxLifespan": 2592000,
  "ssoSessionIdleTimeoutRememberMe": 0,
  "ssoSessionMaxLifespanRememberMe": 0,
  "clientSessionIdleTimeout": 604800,
  "clientSessionMaxLifespan": 2592000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "loginTheme": "email-otp",
  "authenticationFlows": [
    {
      "alias": "supplify-browser-email-otp",
      "description": "Supplify browser login with email OTP",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false
    },
    {
      "alias": "supplify-browser-email-otp-forms",
      "description": "Username/password followed by Supplify email OTP",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false
    }
  ],
  "authenticationExecutions": [
    {
      "authenticator": "auth-cookie",
      "authenticatorFlow": false,
      "flowAlias": "supplify-browser-email-otp",
      "requirement": "ALTERNATIVE",
      "priority": 10,
      "userSetupAllowed": false
    },
    {
      "authenticator": "identity-provider-redirector",
      "authenticatorFlow": false,
      "flowAlias": "supplify-browser-email-otp",
      "requirement": "ALTERNATIVE",
      "priority": 20,
      "userSetupAllowed": false
    },
    {
      "flowAlias": "supplify-browser-email-otp-forms",
      "authenticatorFlow": true,
      "requirement": "REQUIRED",
      "priority": 30,
      "userSetupAllowed": false
    },
    {
      "authenticator": "auth-username-password-form",
      "authenticatorFlow": false,
      "flowAlias": "supplify-browser-email-otp-forms",
      "requirement": "REQUIRED",
      "priority": 10,
      "userSetupAllowed": false
    },
    {
      "authenticator": "email-otp-login",
      "authenticatorFlow": false,
      "flowAlias": "supplify-browser-email-otp-forms",
      "requirement": "REQUIRED",
      "priority": 20,
      "userSetupAllowed": false
    }
  ],
  "browserFlow": "supplify-browser-email-otp",
  "registrationFlow": "registration",
  "requiredActions": [
    {
      "alias": "email-otp-verify-email",
      "name": "Verify email with Supplify OTP",
      "providerId": "email-otp-verify-email",
      "enabled": true,
      "defaultAction": true,
      "priority": 50

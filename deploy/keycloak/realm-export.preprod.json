{
  "realm": "supplify-preprod",
  "enabled": true,
  "sslRequired": "all",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 5,
  "rememberMe": false,
  "accessTokenLifespan": 1200,
  "accessTokenLifespanForImplicitFlow": 1200,
  "ssoSessionIdleTimeout": 604800,
  "ssoSessionMaxLifespan": 2592000,
  "ssoSessionIdleTimeoutRememberMe": 0,
  "ssoSessionMaxLifespanRememberMe": 0,
  "clientSessionIdleTimeout": 604800,
  "clientSessionMaxLifespan": 2592000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "loginTheme": "email-otp",
  "authenticationFlows": [
    {
      "alias": "supplify-browser-email-otp",
      "description": "Supplify browser login with email OTP",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false
    },
    {
      "alias": "supplify-browser-email-otp-forms",
      "description": "Username/password followed by Supplify email OTP",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false
    }
  ],
  "authenticationExecutions": [
    {
      "authenticator": "auth-cookie",
      "authenticatorFlow": false,
      "flowAlias": "supplify-browser-email-otp",
      "requirement": "ALTERNATIVE",
      "priority": 10,
      "userSetupAllowed": false
    },
    {
      "authenticator": "identity-provider-redirector",
      "authenticatorFlow": false,
      "flowAlias": "supplify-browser-email-otp",
      "requirement": "ALTERNATIVE",
      "priority": 20,
      "userSetupAllowed": false
    },
    {
      "flowAlias": "supplify-browser-email-otp-forms",
      "authenticatorFlow": true,
      "requirement": "REQUIRED",
      "priority": 30,
      "userSetupAllowed": false
    },
    {
      "authenticator": "auth-username-password-form",
      "authenticatorFlow": false,
      "flowAlias": "supplify-browser-email-otp-forms",
      "requirement": "REQUIRED",
      "priority": 10,
      "userSetupAllowed": false
    },
    {
      "authenticator": "email-otp-login",
      "authenticatorFlow": false,
      "flowAlias": "supplify-browser-email-otp-forms",
      "requirement": "REQUIRED",
      "priority": 20,
      "userSetupAllowed": false
    }
  ],
  "browserFlow": "supplify-browser-email-otp",
  "registrationFlow": "registration",
  "requiredActions": [
    {
      "alias": "email-otp-verify-email",
      "name": "Verify email with Supplify OTP",
      "providerId": "email-otp-verify-email",
      "enabled": true,
      "defaultAction": true,
      "priority": 50
    }
  ],
  "clients": [
    {
      "clientId": "supplify-api",
      "enabled": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "changeme",
      "redirectUris": [
        "https://app-preprod.supplifyerp.com/auth/callback",
        "https://app-preprod.supplifyerp.com/*",
        "https://api-preprod.supplifyerp.com/auth/callback",
        "https://api-preprod.supplifyerp.com/*",
        "https://supplify-web-preprod-preprod.up.railway.app/auth/callback",
        "https://supplify-web-preprod-preprod.up.railway.app/*",
        "https://supplify-api-preprod-preprod.up.railway.app/auth/callback",
        "https://supplify-api-preprod-preprod.up.railway.app/*"
      ],
      "webOrigins": [
        "https://app-preprod.supplifyerp.com",
        "https://api-preprod.supplifyerp.com",
        "https://supplify-web-preprod-preprod.up.railway.app"
      ],
      "protocol": "openid-connect",
      "attributes": {
        "access.token.lifespan": "1200",
        "access.token.lifespan.for.implicit.flow": "1200",
        "post.logout.redirect.uris": "https://app-preprod.supplifyerp.com/login##https://app-preprod.supplifyerp.com/*##https://api-preprod.supplifyerp.com/auth/register?continue=1##https://api-preprod.supplifyerp.com/auth/register##https://api-preprod.supplifyerp.com/*##https://supplify-web-preprod-preprod.up.railway.app/login##https://supplify-web-preprod-preprod.up.railway.app/*"
      },
      "defaultClientScopes": ["web-origins", "profile", "roles", "email"],
      "optionalClientScopes": ["address", "phone", "offline_access", "microprofile-jwt"]
    },
    {
      "clientId": "supplify-web",
      "enabled": true,
      "publicClient": true,
      "redirectUris": [
        "https://app-preprod.supplifyerp.com/auth/callback",
        "https://app-preprod.supplifyerp.com/*",
        "https://api-preprod.supplifyerp.com/auth/callback",
        "https://api-preprod.supplifyerp.com/*",
        "https://supplify-web-preprod-preprod.up.railway.app/auth/callback",
        "https://supplify-web-preprod-preprod.up.railway.app/*"
      ],
      "webOrigins": [
        "https://app-preprod.supplifyerp.com",
        "https://supplify-web-preprod-preprod.up.railway.app"
      ],
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://app-preprod.supplifyerp.com/login##https://app-preprod.supplifyerp.com/*##https://api-preprod.supplifyerp.com/*##https://supplify-web-preprod-preprod.up.railway.app/login##https://supplify-web-preprod-preprod.up.railway.app/*"
      },
      "defaultClientScopes": ["web-origins", "profile", "roles", "email"],
      "optionalClientScopes": ["address", "phone", "offline_access", "microprofile-jwt"]
    }
  ],
  "roles": {
    "realm": [
      { "name": "admin", "description": "Administrator role" },
      { "name": "supplier", "description": "Supplier role" },
      { "name": "restaurant", "description": "Restaurant role" },
      { "name": "staff_portal", "description": "Operational staff portal (no admin app access)" }
    ]
  }
}

[Unit]
Description=Supplify Docker Compose (Preprod)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/supplify
Environment=SUPPLIFY_ENV=preprod
ExecStart=/usr/bin/docker compose --env-file /opt/supplify/env/.env.preprod -f /opt/supplify/deploy/docker-compose.preprod.yml up -d
ExecStop=/usr/bin/docker compose --env-file /opt/supplify/env/.env.preprod -f /opt/supplify/deploy/docker-compose.preprod.yml down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target

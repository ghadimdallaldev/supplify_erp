[Unit]
Description=Supplify Docker Compose (Staging)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/supplify
Environment=SUPPLIFY_ENV=staging
ExecStart=/usr/bin/docker compose --env-file /opt/supplify/deploy/env/.env.staging -f /opt/supplify/deploy/docker-compose.staging.yml up -d
ExecStop=/usr/bin/docker compose --env-file /opt/supplify/deploy/env/.env.staging -f /opt/supplify/deploy/docker-compose.staging.yml down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "strictPropertyInitialization": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "incremental": true,
    "paths": {
      "@supplify/config": ["./packages/config/src"],
      "@supplify/types": ["./packages/types/src"],
      "@supplify/utils": ["./packages/utils/src"],
      "@supplify/entitlements": ["./packages/entitlements/src"],
      "@supplify/flags-server": ["./packages/flags-server/src"],
      "@supplify/flags-web": ["./packages/flags-web/src"]
    }
  },
  "exclude": ["node_modules", "dist", ".next", ".turbo"]
}

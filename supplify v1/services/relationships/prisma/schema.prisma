// Supplify Relationships Schema
// Manages supplier-restaurant relationships, favorites, and connections

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum RelationshipType {
  FRIEND      // Added as friend/favorite
  BLOCKED     // Blocked user
  PENDING     // Friend request pending
}

enum RelationshipStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

// ============================================================================
// CORE ENTITIES
// ============================================================================

// Supplier-Restaurant Relationships
model Relationship {
  id                String             @id @default(uuid())
  supplierId        String             // Supplier ID from suppliers service
  restaurantId      String             // Restaurant ID from restaurants service
  type              RelationshipType   @default(FRIEND)
  status            RelationshipStatus @default(ACTIVE)
  
  // Metadata
  notes             String?            // Optional notes about the relationship
  tags              String[]           // Custom tags for categorization
  
  // Timestamps
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  lastInteractionAt DateTime?         // Last order or interaction
  
  // Relations
  interactions      Interaction[]       // Track interactions between them
  
  @@unique([supplierId, restaurantId])
  @@index([supplierId])
  @@index([restaurantId])
  @@index([type])
  @@index([status])
  @@map("relationships")
}

// Track interactions between suppliers and restaurants
model Interaction {
  id              String       @id @default(uuid())
  relationshipId  String
  type            String       // "ORDER", "MESSAGE", "CALL", "MEETING", etc.
  description     String?      // Optional description
  metadata        Json?        // Additional context data
  
  createdAt       DateTime     @default(now())
  
  // Relations
  relationship    Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  
  @@index([relationshipId])
  @@index([type])
  @@index([createdAt])
  @@map("interactions")
}

// Supplier preferences and settings
model SupplierPreferences {
  id                String   @id @default(uuid())
  supplierId        String   @unique
  
  // Display preferences
  showInSearch      Boolean  @default(true)
  allowFriendRequests Boolean @default(true)
  
  // Notification preferences
  notifyOnNewOrders Boolean  @default(true)
  notifyOnMessages  Boolean  @default(true)
  notifyOnReviews   Boolean  @default(true)
  
  // Business preferences
  autoAcceptOrders  Boolean  @default(false)
  minOrderAmount    Float?   // Minimum order amount to accept
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@map("supplier_preferences")
}

// Restaurant preferences and settings
model RestaurantPreferences {
  id                String   @id @default(uuid())
  restaurantId      String   @unique
  
  // Display preferences
  showInSearch      Boolean  @default(true)
  allowFriendRequests Boolean @default(true)
  
  // Notification preferences
  notifyOnNewProducts Boolean @default(true)
  notifyOnPromotions  Boolean @default(true)
  notifyOnMessages    Boolean @default(true)
  
  // Order preferences
  preferredSuppliers String[] // Array of preferred supplier IDs
  blockedSuppliers   String[] // Array of blocked supplier IDs
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@map("restaurant_preferences")
}

// Search and discovery tracking
model SearchHistory {
  id              String   @id @default(uuid())
  userId          String   // User ID (supplier or restaurant)
  userType        String   // "SUPPLIER" or "RESTAURANT"
  searchTerm      String
  searchType      String   // "SUPPLIER", "RESTAURANT", "PRODUCT", etc.
  resultsCount    Int
  clickedResults  String[] // IDs of results that were clicked
  
  createdAt       DateTime @default(now())
  
  @@index([userId])
  @@index([searchType])
  @@index([createdAt])
  @@map("search_history")
}

// ============================================================================
// INDEXES AND CONSTRAINTS
// ============================================================================

// Additional indexes for performance
// These would be added to the existing tables in a real implementation

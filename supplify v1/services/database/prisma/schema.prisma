generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Core Multi-Tenant Models
model Organization {
  id          String   @id @default(cuid()) // This is the clientId
  type        String   // RESTAURANT, SUPPLIER, ADMIN
  name        String
  description String?
  website     String?
  phone       String?
  email       String?
  
  // Business Information
  businessType    String?
  address        Json?   // { street, city, state, zipCode, country }
  taxId          String?
  licenseNumber  String?
  
  // Subscription & Tier
  tier           String   @default("FREE") // FREE, BASIC, PRO, PREMIUM
  subscriptionId String?
  trialEndsAt    DateTime?
  
  // Status & Metadata
  status        String   @default("ACTIVE") // ACTIVE, SUSPENDED, INACTIVE
  ownerUserId   String?  // Primary owner
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Relations
  memberships   Membership[]
  subscriptions OrgSubscription[]
  
  // Tenant-scoped data
  products      Product[]
  orders        Order[]
  campaigns     Campaign[]
  inventories   Inventory[]
  chatRooms     ChatRoom[]
  
  @@map("organizations")
}

model Membership {
  id         String   @id @default(cuid())
  userId     String
  clientId   String   // Organization ID (tenant)
  role       String   // OWNER, ADMIN, MEMBER, VIEWER
  status     String   @default("ACTIVE") // ACTIVE, PENDING, SUSPENDED
  joinedAt   DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  // Relations
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  @@unique([userId, clientId])
  @@index([clientId])
  @@map("memberships")
}

model User {
  id             String   @id @default(cuid())
  cognitoSub     String   @unique
  email          String   @unique
  firstName      String
  lastName       String
  role           String   // ADMIN, SUPPLIER, RESTAURANT
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  // Relations
  memberships    Membership[]
  
  @@index([cognitoSub])
  @@index([email])
  @@map("users")
}

model OrgSubscription {
  id              String   @id @default(cuid())
  clientId        String   // Organization ID
  planId          String   // FREE, BASIC, PRO, PREMIUM
  status          String   // ACTIVE, CANCELLED, EXPIRED, TRIAL
  startDate       DateTime @default(now())
  endDate         DateTime?
  trialEndsAt     DateTime?
  autoRenew       Boolean  @default(true)
  
  // Limits & Features
  maxUsers        Int      @default(1)
  maxProducts     Int      @default(100)
  maxOrders       Int      @default(1000)
  maxStorage      Int      @default(1024) // MB
  
  // Billing
  amount          Decimal? @db.Decimal(10, 2)
  currency        String   @default("USD")
  billingCycle    String   @default("MONTHLY") // MONTHLY, YEARLY
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  organization    Organization @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  @@index([clientId])
  @@map("org_subscriptions")
}

// Audit Logging
model AuditLog {
  id          String   @id @default(cuid())
  clientId    String   // Tenant context
  userId      String   // User who performed action
  action      String   // CREATE, UPDATE, DELETE, LOGIN, IMPERSONATE
  entity      String   // Product, Order, Campaign, etc.
  entityId    String?  // ID of affected entity
  before      Json?    // State before change
  after       Json?    // State after change
  metadata    Json?    // Additional context
  ipAddress   String?
  userAgent   String?
  timestamp   DateTime @default(now())
  
  @@index([clientId, timestamp])
  @@index([userId, timestamp])
  @@map("audit_logs")
}

// Multi-Tenant Product Model
model Product {
  id          String   @id @default(cuid())
  clientId    String   // Tenant (Supplier Organization)
  supplierId  String   // Supplier user ID
  
  // Product Details
  name        String
  description String?
  sku         String
  category    String?
  brand       String?
  
  // Pricing
  price       Decimal  @db.Decimal(10, 2)
  compareAtPrice Decimal? @db.Decimal(10, 2)
  costPrice   Decimal? @db.Decimal(10, 2)
  
  // Inventory
  quantity    Int      @default(0)
  minQuantity Int      @default(0)
  maxQuantity Int?
  
  // Media
  images      String[] @default([])
  tags        String[] @default([])
  
  // Status
  status      String   @default("ACTIVE") // ACTIVE, INACTIVE, OUT_OF_STOCK
  featured    Boolean  @default(false)
  
  // Metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  organization Organization @relation(fields: [clientId], references: [id], onDelete: Cascade)
  orders       OrderItem[]
  inventories  Inventory[]
  
  @@unique([clientId, sku])
  @@index([clientId, supplierId])
  @@index([clientId, status])
  @@map("products")
}

// Multi-Tenant Order Model
model Order {
  id          String   @id @default(cuid())
  clientId    String   // Tenant context
  restaurantId String  // Restaurant user ID
  supplierId  String   // Supplier user ID
  
  // Order Details
  orderNumber String
  status      String   @default("PLACED") // PLACED, ACKNOWLEDGED, PREPARING, DISPATCHED, DELIVERED, CANCELLED
  
  // Pricing
  subtotal    Decimal  @db.Decimal(10, 2)
  tax         Decimal  @db.Decimal(10, 2)
  shipping    Decimal  @db.Decimal(10, 2)
  total       Decimal  @db.Decimal(10, 2)
  
  // Delivery
  deliveryAddress Json? // { street, city, state, zipCode, country }
  deliveryDate   DateTime?
  deliveryNotes  String?
  
  // SLA Management
  etaAt          DateTime?
  ackBySlaAt     DateTime?
  dispatchedAt   DateTime?
  deliveredAt    DateTime?
  cancelReason   String?
  meta           Json?
  
  // Metadata
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  // Relations
  organization   Organization @relation(fields: [clientId], references: [id], onDelete: Cascade)
  items          OrderItem[]
  events         OrderEvent[]
  messages       OrderMessage[]
  
  @@index([clientId, status])
  @@index([clientId, restaurantId])
  @@index([clientId, supplierId])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  clientId  String   // Tenant context
  
  quantity  Int
  price     Decimal  @db.Decimal(10, 2)
  total     Decimal  @db.Decimal(10, 2)
  
  // Relations
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  @@index([clientId, orderId])
  @@map("order_items")
}

model OrderEvent {
  id          String   @id @default(cuid())
  orderId     String
  clientId    String   // Tenant context
  
  actorType   String   // USER, SYSTEM, SUPPLIER, RESTAURANT
  actorId     String
  type        String   // STATUS_CHANGE, MESSAGE, DELIVERY_UPDATE
  from        String?
  to          String?
  payload     Json?
  
  createdAt   DateTime @default(now())
  
  // Relations
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  @@index([clientId, orderId])
  @@map("order_events")
}

model OrderMessage {
  id          String   @id @default(cuid())
  orderId     String
  clientId    String   // Tenant context
  
  senderId    String
  senderType  String   // RESTAURANT, SUPPLIER
  body        String
  attachments String[] @default([])
  
  createdAt   DateTime @default(now())
  
  // Relations
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  @@index([clientId, orderId])
  @@map("order_messages")
}

// Multi-Tenant Campaign Model
model Campaign {
  id          String   @id @default(cuid())
  clientId    String   // Tenant context
  supplierId  String   // Supplier user ID
  
  // Campaign Details
  name        String
  description String?
  type        String   // SPONSORED_VISIBILITY, DISCOUNT, FEATURED_PRODUCT
  
  // Targeting
  placement   String?  // SUPPLIER_CARD, PRODUCT_LIST, SEARCH_RESULT
  targetType  String?  // ALL, CATEGORY, SPECIFIC_PRODUCTS
  
  // Budgeting
  dailyBudgetUSD    Decimal? @db.Decimal(10, 2)
  totalBudgetUSD    Decimal? @db.Decimal(10, 2)
  cpmUSD           Decimal? @db.Decimal(10, 2)
  cpcUSD           Decimal? @db.Decimal(10, 2)
  
  // Discount Settings
  discountType      String?  // PERCENTAGE, FIXED_AMOUNT
  discountValue     Decimal? @db.Decimal(10, 2)
  minQty            Int?
  
  // Featured Settings
  featureSlots      Int[]    @default([])
  
  // Status
  status            String   @default("PENDING") // PENDING, APPROVED, REJECTED, PAUSED, ACTIVE, ENDED
  approvedAt        DateTime?
  approvedBy        String?
  startDate         DateTime?
  endDate           DateTime?
  
  // Metadata
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Relations
  organization      Organization @relation(fields: [clientId], references: [id], onDelete: Cascade)
  stats             AdStat[]
  impressions       ImpressionLog[]
  clicks            ClickLog[]
  
  @@index([clientId, status])
  @@index([clientId, supplierId])
  @@map("campaigns")
}

model AdStat {
  id          String   @id @default(cuid())
  campaignId  String
  clientId    String   // Tenant context
  
  date        DateTime
  impressions Int      @default(0)
  clicks      Int      @default(0)
  spend       Decimal  @db.Decimal(10, 2) @default(0)
  
  // Relations
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  
  @@unique([campaignId, date])
  @@index([clientId, date])
  @@map("ad_stats")
}

model ImpressionLog {
  id          String   @id @default(cuid())
  campaignId  String
  clientId    String   // Tenant context
  
  userId      String?
  sessionId   String?
  ipAddress   String?
  userAgent   String?
  
  createdAt   DateTime @default(now())
  
  // Relations
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  
  @@index([clientId, createdAt])
  @@map("impression_logs")
}

model ClickLog {
  id          String   @id @default(cuid())
  campaignId  String
  clientId    String   // Tenant context
  
  userId      String?
  sessionId   String?
  ipAddress   String?
  userAgent   String?
  
  createdAt   DateTime @default(now())
  
  // Relations
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  
  @@index([clientId, createdAt])
  @@map("click_logs")
}

// Multi-Tenant Inventory Model
model Inventory {
  id          String   @id @default(cuid())
  clientId    String   // Tenant context
  productId   String
  restaurantId String  // Restaurant user ID
  
  quantity    Int      @default(0)
  minQuantity Int      @default(0)
  maxQuantity Int?
  
  location    String?  // Warehouse, Store, etc.
  notes       String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  organization Organization @relation(fields: [clientId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  @@unique([clientId, productId, restaurantId])
  @@index([clientId, restaurantId])
  @@map("inventories")
}

// Multi-Tenant Chat Model
model ChatRoom {
  id          String   @id @default(cuid())
  clientId    String   // Tenant context
  
  type        String   // ORDER_CHAT, SUPPORT_CHAT
  orderId     String?
  
  participants String[] // User IDs
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  organization Organization @relation(fields: [clientId], references: [id], onDelete: Cascade)
  messages     ChatMessage[]
  
  @@index([clientId, type])
  @@map("chat_rooms")
}

model ChatMessage {
  id          String   @id @default(cuid())
  roomId      String
  clientId    String   // Tenant context
  
  senderId    String
  senderType  String   // RESTAURANT, SUPPLIER, ADMIN
  content     String
  attachments String[] @default([])
  
  createdAt   DateTime @default(now())
  
  // Relations
  room        ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  
  @@index([clientId, roomId])
  @@map("chat_messages")
}

// Multi-Tenant Feature Flags
model FeatureFlag {
  id              String   @id @default(cuid())
  key             String   @unique
  name            String
  description     String
  enabledByDefault Boolean  @default(false)
  dependencies    String[] @default([])
  tags            String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  rules           FlagRule[]
  overrides       FlagOverride[]
  
  @@map("feature_flags")
}

model FlagRule {
  id            String   @id @default(cuid())
  flagId        String
  clientId      String?  // Tenant-specific rule (null = global)
  environment   String   @default("dev")
  status        String   // OFF, ON, ROLLOUT
  rolloutPct    Int      @default(0)
  targetOrgType String?  // SUPPLIER, RESTAURANT, null for all
  targetOrgIds  String[] @default([])
  priority      Int      @default(0)
  conditions    Json?    // Additional conditions
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  flag          FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)
  
  @@index([clientId])
  @@map("flag_rules")
}

model FlagOverride {
  id            String   @id @default(cuid())
  flagId        String
  clientId      String?  // Tenant-specific override (null = global)
  environment   String   @default("dev")
  orgType       String?  // SUPPLIER, RESTAURANT
  orgId         String?
  userId        String?
  forcedStatus  String   // FORCE_ON, FORCE_OFF
  note          String?
  createdBy     String
  createdAt     DateTime @default(now())

  flag          FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)
  
  @@index([clientId])
  @@map("flag_overrides")
}
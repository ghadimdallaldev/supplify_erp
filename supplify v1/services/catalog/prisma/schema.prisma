generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        String   @id @default(cuid())
  parentId  String?
  name      String
  slug      String   @unique
  path      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([slug])
  @@index([parentId])
  @@map("categories")
}

model Product {
  id             String   @id @default(cuid())
  supplierId     String
  sku            String   // Supplier's SKU
  name           String
  slug           String   @unique
  brand          String?
  categoryId     String
  unit           String
  packSize       String?
  leadTimeDays   Int      @default(2)
  currency       String   @default("USD")
  price          Decimal  @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2)
  stockQty       Int      @default(0)
  minOrderQty    Int      @default(1)
  imageKeys      String[] @db.Text
  attributes     Json     @default("{}")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id])

  @@unique([supplierId, sku])
  @@index([supplierId])
  @@index([categoryId])
  @@index([name])
  @@index([active])
  @@map("products")
}

model ProductImport {
  id             String   @id @default(cuid())
  supplierId     String
  status         String   @default("PENDING") // PENDING|VALIDATING|READY|IMPORTING|COMPLETED|FAILED|REJECTED|CANCELLED
  fileKey        String   // S3 key of original file
  fileType       String   // xlsx|csv
  totalRows      Int      @default(0)
  validRows      Int      @default(0)
  invalidRows    Int      @default(0)
  warnings       Json?
  errorReportKey String?  // S3 key of error CSV
  summary        Json?
  createdBy      String   // userId
  reviewedBy     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  rows           ProductImportRow[]

  @@index([supplierId, status])
  @@index([status])
  @@index([createdAt])
  @@map("product_imports")
}

model ProductImportRow {
  id         String   @id @default(cuid())
  importId   String
  rowNumber  Int
  data       Json     // Normalized product data
  status     String   @default("PENDING") // PENDING|VALID|INVALID|IMPORTED|SKIPPED
  errors     Json?
  warnings   Json?
  productId  String?  // If imported successfully
  createdAt  DateTime @default(now())

  import     ProductImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId, status])
  @@index([importId, rowNumber])
  @@map("product_import_rows")
}


generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PointsLedger {
  id         String   @id @default(cuid())
  entityId   String
  entityType String
  delta      Int
  reason     String
  orderId    String?
  createdAt  DateTime @default(now())

  @@index([entityId])
  @@index([entityType])
  @@map("points_ledger")
}

model LoyaltyProgram {
  id          String @id @default(cuid())
  supplierId  String
  name        String
  active      Boolean @default(true)
  earnRate    Decimal @db.Numeric(10,4) // points per 1 unit of currency
  redeemRate  Decimal @db.Numeric(10,4) // currency value per 1 point
  minRedeem   Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  wallets     LoyaltyWallet[]
  @@index([supplierId, active])
  @@map("loyalty_programs")
}

model LoyaltyWallet {
  id           String @id @default(cuid())
  supplierId   String
  restaurantId String
  programId    String?
  points       Int @default(0)
  updatedAt    DateTime @updatedAt

  program      LoyaltyProgram? @relation(fields: [programId], references: [id])
  transactions LoyaltyTransaction[]

  @@unique([supplierId, restaurantId])
  @@map("loyalty_wallets")
}

model LoyaltyTransaction {
  id           String @id @default(cuid())
  walletId     String
  type         String // EARN|REDEEM|ADJUST
  points       Int
  orderId      String?
  meta         Json?
  createdAt    DateTime @default(now())

  wallet       LoyaltyWallet @relation(fields: [walletId], references: [id])
  @@index([walletId])
  @@index([orderId])
  @@map("loyalty_transactions")
}


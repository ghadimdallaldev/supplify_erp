generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SpendBySupplier {
  id           String  @id @default(cuid())
  restaurantId String
  supplierId   String
  supplierName String
  totalSpend   Decimal @db.Decimal(12, 2)
  orderCount   Int
  period       String

  @@unique([restaurantId, supplierId, period])
  @@index([restaurantId])
  @@map("spend_by_supplier")
}

model TopItem {
  id           String  @id @default(cuid())
  restaurantId String
  productId    String
  productName  String
  quantity     Int
  totalSpend   Decimal @db.Decimal(12, 2)
  period       String

  @@unique([restaurantId, productId, period])
  @@index([restaurantId])
  @@map("top_items")
}


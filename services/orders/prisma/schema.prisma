generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  PLACED
  PROCESSING
  ACKNOWLEDGED
  PREPARING
  DISPATCHED
  DELIVERED
  CANCELLED
  ETA_UPDATED
  NOTE_ADDED
}

enum OrderEventType {
  PENDING
  PLACED
  PROCESSING
  ACKNOWLEDGED
  PREPARING
  DISPATCHED
  DELIVERED
  CANCELLED
  ETA_UPDATED
  NOTE_ADDED
}

model Cart {
  id           String     @id @default(cuid())
  clientId     String     // Multi-tenant scope
  restaurantId String
  items        CartItem[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([clientId, restaurantId])
  @@map("carts")
}

model CartItem {
  id         String  @id @default(cuid())
  clientId   String  // Multi-tenant scope
  cartId     String
  productId  String
  supplierId String
  qty        Int
  unitPrice  Decimal @db.Decimal(12, 2)
  notes      String?

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@index([clientId, cartId])
  @@index([productId])
  @@map("cart_items")
}

model Order {
  id              String       @id @default(cuid())
  clientId        String       // Multi-tenant scope
  parentOrderId   String?      // if needed for multi-supplier split
  restaurantId    String
  supplierId      String
  status          OrderStatus  @default(PENDING)
  etaAt           DateTime?
  ackBySlaAt      DateTime?    // acknowledgement deadline
  dispatchedAt    DateTime?
  deliveredAt     DateTime?
  cancelReason    String?
  meta            Json?        // carrier info, driver details, etc.
  subtotal        Decimal      @db.Decimal(12, 2)
  discount        Decimal      @db.Decimal(12, 2) @default(0)   // loyalty or promo
  tax             Decimal      @db.Decimal(12, 2) @default(0)
  shipping        Decimal      @db.Decimal(12, 2) @default(0)
  totalNet        Decimal      @db.Decimal(12, 2) @default(0)
  currency        String?      @default("USD")
  deliveryAddress String
  notes           String?
  placedAt        DateTime     @default(now())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  items           OrderItem[]
  events          OrderEvent[]
  messages        OrderMessage[]
  invoices        Invoice[]

  @@index([clientId, restaurantId, supplierId, status])
  @@index([status, ackBySlaAt])
  @@map("orders")
}

model OrderItem {
  id             String  @id @default(cuid())
  clientId       String  // Multi-tenant scope
  orderId        String
  supplierProductId String
  restaurantItemId String?
  qtyOrderedBase   Int
  qtyDeliveredBase Int @default(0)
  uomBase        String
  unitPrice      Decimal @db.Decimal(12, 2)
  lineTotal      Decimal @db.Decimal(12, 2)
  meta           Json?
  createdAt      DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([clientId, orderId])
  @@map("order_items")
}

model OrderEvent {
  id        String @id @default(cuid())
  clientId  String // Multi-tenant scope
  orderId   String
  type      String   // PLACED|ACKNOWLEDGED|PREPARING|DISPATCHED|DELIVERED|CANCELLED|ETA_UPDATED|NOTE_ADDED
  payload   Json?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([clientId, orderId, type])
  @@map("order_events")
}

model OrderMessage {
  id          String   @id @default(cuid())
  orderId     String
  senderId    String
  senderRole  String   // SUPPLIER|RESTAURANT|ADMIN
  body        String
  attachments String[] @db.Text
  createdAt   DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_messages")
}

model Invoice {
  id              String   @id @default(cuid())
  orderId         String
  restaurantId    String
  supplierId      String
  invoiceNumber   String   @unique
  status          String   @default("DRAFT") // DRAFT|SENT|PAID|OVERDUE|CANCELLED
  subtotal        Decimal  @db.Decimal(12, 2)
  taxAmount       Decimal  @db.Decimal(12, 2)
  discountAmount  Decimal  @db.Decimal(12, 2)
  total           Decimal  @db.Decimal(12, 2)
  currency        String   @default("USD")
  issueDate       DateTime @default(now())
  dueDate         DateTime?
  paidAt          DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  items           InvoiceItem[]

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  productId   String
  productName String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)
  notes       String?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model IdempotencyKey {
  id           String   @id @default(cuid())
  clientId     String   // Multi-tenant scope
  key          String   @unique
  resourceType String   // order|order_event|inventory_update
  resourceId   String?  // the ID of the created/updated resource
  payload      Json?    // the original request payload
  createdAt    DateTime @default(now())
  expiresAt    DateTime // TTL for cleanup

  @@index([clientId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}


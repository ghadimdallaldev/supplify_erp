// Multi-Tenant Chat Models
model ChatThread {
  id          String   @id @default(cuid())
  clientId    String   // Tenant context
  scope       String   // ORDER, ORG, SUPPORT
  orderId     String?  // For order-scoped chats
  participants String[] // User IDs
  title       String?
  description String?
  status      String   @default("ACTIVE") // ACTIVE, ARCHIVED, CLOSED
  lastMessageAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  organization Organization @relation(fields: [clientId], references: [id], onDelete: Cascade)
  messages     ChatMessage[]
  readReceipts ChatReadReceipt[]
  
  @@index([clientId, scope])
  @@index([clientId, orderId])
  @@index([clientId, status])
  @@map("chat_threads")
}

model ChatMessage {
  id          String   @id @default(cuid())
  threadId    String
  clientId    String   // Tenant context
  
  senderId    String
  senderRole  String   // RESTAURANT, SUPPLIER, ADMIN
  senderName  String?
  body        String
  messageType String   @default("TEXT") // TEXT, IMAGE, FILE, SYSTEM
  attachments String[] @default([])
  metadata    Json?    // Additional message data
  
  // Message status
  status      String   @default("SENT") // SENT, DELIVERED, READ, FAILED
  editedAt    DateTime?
  deletedAt   DateTime?
  
  // Realtime features
  isTyping    Boolean  @default(false)
  replyToId   String?  // For message replies
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  thread      ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  readReceipts ChatReadReceipt[]
  replyTo     ChatMessage? @relation("MessageReply", fields: [replyToId], references: [id])
  replies     ChatMessage[] @relation("MessageReply")
  
  @@index([clientId, threadId])
  @@index([clientId, senderId])
  @@index([clientId, createdAt])
  @@map("chat_messages")
}

model ChatReadReceipt {
  id          String   @id @default(cuid())
  messageId   String
  threadId    String
  clientId    String   // Tenant context
  
  userId      String
  readAt      DateTime @default(now())
  
  // Relations
  message     ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  thread      ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  
  @@unique([messageId, userId])
  @@index([clientId, threadId])
  @@map("chat_read_receipts")
}

model ChatTypingIndicator {
  id          String   @id @default(cuid())
  threadId    String
  clientId    String   // Tenant context
  
  userId      String
  userName    String?
  isTyping    Boolean  @default(true)
  lastSeen    DateTime @default(now())
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([threadId, userId])
  @@index([clientId, threadId])
  @@map("chat_typing_indicators")
}

model ChatNotification {
  id          String   @id @default(cuid())
  clientId    String   // Tenant context
  
  userId      String
  threadId    String
  messageId   String?
  
  type        String   // MESSAGE, TYPING, READ_RECEIPT, THREAD_CREATED
  title       String
  body        String
  data        Json?    // Additional notification data
  
  // Delivery status
  status      String   @default("PENDING") // PENDING, SENT, DELIVERED, FAILED
  sentAt      DateTime?
  deliveredAt DateTime?
  
  // Read status
  readAt      DateTime?
  
  createdAt   DateTime @default(now())
  
  @@index([clientId, userId])
  @@index([clientId, status])
  @@map("chat_notifications")
}
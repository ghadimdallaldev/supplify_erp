generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CampaignType {
  SPONSORED_VISIBILITY
  DISCOUNT
  FEATURED_PRODUCT
}

model Campaign {
  id              String       @id @default(cuid())
  supplierId      String
  type            CampaignType
  name            String
  description     String?
  // placement only matters for Sponsored Visibility
  placement       String?      // SUPPLIER_CARD | PRODUCT_LIST | SEARCH_RESULT
  status          String       @default("DRAFT") // DRAFT | PENDING | ACTIVE | PAUSED | ENDED | REJECTED | EXHAUSTED
  startDate       DateTime
  endDate         DateTime
  dailyBudgetUSD  Decimal?     @db.Numeric(12,2) // null for pure non-media types
  totalBudgetUSD  Decimal?     @db.Numeric(12,2) // null for non-media
  spentUSD        Decimal      @db.Numeric(12,2) @default(0)
  cpmUSD          Decimal?     @db.Numeric(10,4) // only for Sponsored Visibility
  cpcUSD          Decimal?     @db.Numeric(10,4)
  targetType      String       @default("PRODUCT") // PRODUCT | CATEGORY | SUPPLIER
  targetIds       String[]     @db.Text
  keywords        String[]     @db.Text
  priorityScore   Float        @default(1.0)
  // Discount specific
  discountType    String?      // PERCENT | AMOUNT
  discountValue   Decimal?     @db.Numeric(10,2) // percent 0-100 or currency amount
  minQty          Int?         // optional threshold
  // Featured specific
  featureSlots     Int?         // number of top slots to claim on supplier page (default 1-3)
  approved        Boolean      @default(false)
  approvedBy      String?
  approvedAt      DateTime?
  createdBy       String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Relations
  stats           AdStat[]
  clickLogs       ClickLog[]
  impressionLogs  ImpressionLog[]

  @@index([supplierId, status])
  @@index([type, status])
  @@index([startDate, endDate])
  @@map("campaigns")
}

model AdStat {
  id           String   @id @default(cuid())
  campaignId   String
  day          DateTime // date bucket (UTC midnight)
  impressions  Int      @default(0)
  clicks       Int      @default(0)
  spendUSD     Decimal  @db.Numeric(12,2) @default(0)
  conversions  Int      @default(0) // optional future
  createdAt    DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, day])
  @@index([campaignId, day])
  @@map("ad_stats")
}

model ClickLog {
  id           String   @id @default(cuid())
  campaignId   String
  userId       String?
  orgId        String?
  ip           String?
  ua           String?
  createdAt    DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
  @@map("click_logs")
}

model ImpressionLog {
  id           String   @id @default(cuid())
  campaignId   String
  userId       String?
  orgId        String?
  viewId       String?  // client-generated uuid per render
  createdAt    DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
  @@index([viewId])
  @@map("impression_logs")
}
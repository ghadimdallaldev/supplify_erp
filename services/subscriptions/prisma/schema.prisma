// Supplify Subscriptions & Billing Schema
// Manages subscription plans and org subscriptions with entitlements

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// SUBSCRIPTION PLANS
// ============================================================================

model SubscriptionPlan {
  id           String   @id @default(cuid())
  code         String   @unique // BASIC, PRO, PREMIUM
  name         String
  description  String?
  isActive     Boolean  @default(true)
  // JSON of entitlements (features + limits)
  entitlements Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("subscription_plans")
}

// ============================================================================
// ORG SUBSCRIPTIONS
// ============================================================================

model OrgSubscription {
  id          String    @id @default(cuid())
  orgId       String    // supplierId or restaurantId
  orgType     String    // 'SUPPLIER' | 'RESTAURANT'
  planId      String
  planCode    String    // BASIC, PRO, PREMIUM (redundant for fast reads)
  status      String    @default("ACTIVE") // ACTIVE, PAUSED, CANCELLED
  startsAt    DateTime  @default(now())
  endsAt      DateTime?
  trialEndsAt DateTime?
  // Optional per-org overrides (JSON) { limits: {...}, flags: {...} }
  overrides   Json?
  updatedBy   String?   // admin user id who made the change
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([orgId, orgType])
  @@index([orgId, orgType])
  @@index([planCode])
  @@index([status])
  @@map("org_subscriptions")
}

// ============================================================================
// SUBSCRIPTION EVENTS (Audit Trail)
// ============================================================================

model SubscriptionEvent {
  id             String   @id @default(cuid())
  orgId          String
  orgType        String
  eventType      String   // ASSIGNED, UPDATED, CANCELLED, TRIAL_STARTED, TRIAL_ENDED
  previousPlan   String?
  newPlan        String?
  previousStatus String?
  newStatus      String?
  changedBy      String?  // admin user id
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([orgId, orgType])
  @@index([eventType])
  @@index([createdAt])
  @@map("subscription_events")
}


flowchart TB
  subgraph AdminUI["Admin UI"]
    Tenants[Tenants tab]
    Btn[Impersonate button]
    Banner[ImpersonationBanner sticky]
    Exit[Exit impersonation]
    TenantNav[Tenant sidebar pages]
  end

  subgraph API["API"]
    Start[POST /api/admin-dashboard/impersonate]
    Status[GET /api/admin-dashboard/impersonate]
    Stop[POST /api/admin-dashboard/impersonate/stop]
    Ctx[impersonationContext middleware]
    Eff[getEffectiveTenant / getRequestTenant]
    Guard[rejectImpersonationMutation on billing]
  end

  subgraph Storage["Persistence"]
    Cookie[impersonation_token cookie JWT]
    AuditStart[admin_audit_log IMPERSONATION_START]
    AuditEnd[admin_audit_log IMPERSONATION_END]
    AuditBlock[audit_logs impersonation.blocked_action]
  end

  Tenants --> Btn --> Start
  Start --> CheckAdmin{Contact is ADMIN user?}
  CheckAdmin -->|yes| Deny403[403 FORBIDDEN]
  CheckAdmin -->|no| CheckSusp{Suspended / inactive?}
  CheckSusp -->|yes, no ack| DenySusp[403 TENANT_SUSPENDED]
  CheckSusp -->|ok or ack| Cookie
  Cookie --> AuditStart
  Start --> Redirect["redirectTo /app/dashboard"]
  Redirect --> TenantNav[Full tenant UI nav\nSidebar uses effectiveRole]
  Ctx --> Eff
  TenantNav --> Eff
  Eff --> Guard
  Guard -->|billing POST| AuditBlock
  Banner --> Status
  Exit --> Stop
  Stop --> Cookie
  Stop --> AuditEnd
  Logout[POST /auth/logout] --> Cookie

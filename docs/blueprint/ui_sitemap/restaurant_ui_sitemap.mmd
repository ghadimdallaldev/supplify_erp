%%{init: {'theme':'base', 'themeVariables': { 'primaryColor':'#e3f2fd', 'primaryTextColor':'#0d47a1', 'primaryBorderColor':'#1976d2', 'lineColor':'#546e7a', 'secondaryColor':'#f5f5f5', 'tertiaryColor':'#fffde7' }}}%%
flowchart TB
  Root["/"]
  App["/app"]

  subgraph core[" Core "]
    Dashboard["/app/dashboard\nDashboard"]
    Onboarding["/app/onboarding\nOnboarding"]
  end

  subgraph commerce[" Orders & Cart "]
    Orders["/app/orders\nOrders"]
    OrderDetail["/app/orders/:id\nOrder details"]
    Cart["/app/cart\nCart"]
  end

  subgraph catalog[" Catalog & Lists "]
    Products["/app/products\nProducts"]
    QuickLists["/app/quick-lists\nQuick lists"]
  end

  subgraph operations[" Inventory & Suppliers "]
    RestaurantInventory["/app/restaurant-inventory\nInventory"]
    Suppliers["/app/suppliers\nSuppliers"]
    Receiving["/app/receiving\nReceiving"]
  end

  subgraph people[" People & Bookings "]
    Reservations["/app/reservations\nReservations"]
    Staff["/app/staff\nStaff"]
  end

  subgraph comms[" Comms & Billing "]
    Chat["/app/chat\nChat"]
    Invoices["/app/invoices\nInvoices"]
  end

  subgraph account[" Account "]
    Settings["/app/settings\nSettings\nSubscription, Usage"]
  end

  Root --> App
  App --> Dashboard
  App --> Onboarding
  App --> Orders
  App --> Cart
  App --> Products
  App --> QuickLists
  App --> RestaurantInventory
  App --> Suppliers
  App --> Receiving
  App --> Reservations
  App --> Staff
  App --> Chat
  App --> Invoices
  App --> Settings
  Orders --> OrderDetail

  classDef root fill:#fff3e0,stroke:#e65100,stroke-width:2px
  classDef app fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
  class Root root
  class App app

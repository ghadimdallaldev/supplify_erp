  subscription_plan {
    uuid id PK
    text code
    text tenant_type
    jsonb limits
    jsonb features
  }
  subscription {
    uuid id PK
    uuid tenant_id
    text tenant_type
    uuid plan_id FK
    text status
    uuid pending_plan_id FK
    timestamptz pending_effective_at
    text previous_plan_code
  }
  subscription_change_log {
    uuid id PK
    uuid subscription_id FK
    uuid from_plan_id FK
    uuid to_plan_id FK
    uuid changed_by_admin_id FK
    text reason
  }
  tenant_limit_override {
    uuid id PK
    uuid tenant_id
    text tenant_type
    text limit_type
    int override_value
    timestamp expiration_date
  }
  usage_meter {
    uuid id PK
    uuid tenant_id
    text tenant_type
    text meter_type
    int current_value
    date period_start_date
  }
  audit_logs {
    uuid id PK
    text action_type
    uuid actor_user_id
    text tenant_type
    uuid tenant_id
    jsonb payload_json
    text request_id
  }
  system_event {
    uuid id PK
    text type
    text severity
    text source
    jsonb payload
    timestamptz created_at
  }
  restaurant {
    uuid id PK
    text name
    text status
  }
  supplier {
    uuid id PK
    text name
    text status
  }
  invoice {
    uuid id PK
    uuid restaurant_id FK
    uuid supplier_id FK
    numeric total_amount
    numeric balance_due
    text status
    date due_date
  }
  invoice_line_item {
    uuid id PK
    uuid invoice_id FK
    uuid product_id FK
    numeric quantity
    numeric unit_price
  }
  payment {
    uuid id PK
    uuid invoice_id FK
    numeric amount
    text status
    timestamptz created_at
  }
  customer_order {
    uuid id PK
    uuid restaurant_id FK
    text status
  }
  order_item {
    uuid id PK
    uuid customer_order_id FK
    uuid product_id FK
    numeric quantity
  }
  product {
    uuid id PK
    uuid supplier_id FK
    text name
    text sku
  }
  price {
    uuid id PK
    uuid product_id FK
    uuid restaurant_id FK
    numeric unit_price
  }
  inventory {
    uuid id PK
    uuid product_id FK
    uuid warehouse_id FK
    int quantity
    int reserved_qty
  }
  restaurant_inventory {
    uuid id PK
    uuid restaurant_id FK
    uuid product_id FK
    numeric par_level
    numeric current_qty
  }
  warehouse {
    uuid id PK
    uuid supplier_id FK
    text name
  }
  branch {
    uuid id PK
    uuid restaurant_id FK
    text name
  }
  app_user {
    uuid id PK
    text role
  }
  role {
    uuid id PK
    text name
    text tenant_type
  }
  permission {
    uuid id PK
    text code
  }
  role_permission {
    uuid role_id FK
    uuid permission_id FK
  }
  user_role {
    uuid app_user_id FK
    uuid role_id FK
    uuid tenant_id FK
  }
  conversation {
    uuid id PK
    uuid restaurant_id FK
    uuid supplier_id FK
  }
  message {
    uuid id PK
    uuid conversation_id FK
    uuid sender_id FK
    text body
    timestamptz created_at
  }
  reservation {
    uuid id PK
    uuid restaurant_id FK
    uuid branch_id FK
    text guest_name
    text status
    timestamptz slot_at
  }
  reservation_table {
    uuid id PK
    uuid branch_id FK
    text name
    int capacity
  }
  staff_member {
    uuid id PK
    uuid restaurant_id FK
    uuid app_user_id FK
  }
  staff_shift {
    uuid id PK
    uuid staff_member_id FK
    timestamptz start_at
    timestamptz end_at

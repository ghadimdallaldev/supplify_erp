    uuid id PK
    uuid quick_list_id FK
    uuid product_id FK
    numeric quantity
  }
  receiving_report {
    uuid id PK
    uuid customer_order_id FK
    uuid restaurant_id FK
    text status
  }
  receiving_line_item {
    uuid id PK
    uuid receiving_report_id FK
    uuid order_item_id FK
    numeric received_qty
  }
  attachment {
    uuid id PK
    text file_name
    text storage_key
    int file_size
  }
  notification_preferences {
    uuid id PK
    uuid app_user_id FK
    jsonb channels
  }
  delivery_wave {
    uuid id PK
    uuid supplier_id FK
    text status
  }
  pick_list {
    uuid id PK
    uuid delivery_wave_id FK
    uuid customer_order_id FK
  }


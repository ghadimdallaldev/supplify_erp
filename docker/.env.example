# Copy to docker/.env (or repo root .env) before: docker compose up -d --build

# ── Postgres ───────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=supplify
POSTGRES_PORT=5432

# ── App URLs (browser-facing; used when building the web image) ────────────────
APP_PORT=80
VITE_API_URL=http://localhost
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=Supplify
WEB_ORIGIN=http://localhost

# ── Keycloak master admin (not the Supplify realm users) ───────────────────────
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_CLIENT_SECRET=changeme

# ── MinIO (S3-compatible storage) ──────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=supplify
# Optional extra buckets to create at startup (comma-separated)
# S3_BUCKETS=supplify,supplify-media
# Browser-facing MinIO URL (native dev / mapped port 9000)
S3_PUBLIC_URL=http://localhost:9000
S3_PUBLIC_READ=true
MINIO_PUBLIC_READ=true

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PORT=6379

# ── API performance (passed to api service via docker-compose.yml) ─────────────
DATABASE_POOL_MAX=20
DATABASE_POOL_IDLE_TIMEOUT_MS=600000
SLOW_REQUEST_MS=800
IDLE_PERF_LOG_MS=0
DB_KEEPALIVE_ENABLED=false
DB_KEEPALIVE_INTERVAL_SECONDS=60

# ── Mailpit (fake SMTP — view mail at http://localhost:8025) ─────────────────
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ── API ──────────────────────────────────────────────────────────────────────
SESSION_SECRET=dev-session-secret-change-me
# B2C diner signup/login JWT (separate from Keycloak; defaults to SESSION_SECRET)
CONSUMER_AUTH_SECRET=
NODE_ENV=development
STAFF_PORTAL_BASE_URL=http://localhost
CRONS_ENABLED=true
# CRON_OPERATIONAL_REMINDERS_INTERVAL_MS=86400000

# ── Email (transactional notifications → Mailpit) ───────────────────────────
EMAIL_ENABLED=true
EMAIL_PROVIDER=smtp
EMAIL_LOG_ONLY=false
EMAIL_FROM_NAME=Supplify
EMAIL_FROM_ADDRESS=noreply@supplify.local
EMAIL_REPLY_TO=
EMAIL_TEST_TO=
# API container uses hostname mailpit; native pnpm dev syncs localhost:1025 via .env.docker-sync
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@supplify.local

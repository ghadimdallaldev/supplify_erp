# Copy to docker/.env (or repo root .env) before: docker compose up -d --build

# ── Postgres ───────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=supplify
POSTGRES_PORT=5432

# ── App URLs (browser-facing; used when building the web image) ────────────────
APP_PORT=80
VITE_API_URL=http://localhost
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=Supplify
WEB_ORIGIN=http://localhost

# ── Keycloak master admin (not the Supplify realm users) ───────────────────────
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_CLIENT_SECRET=changeme

# ── MinIO (S3-compatible storage) ──────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=supplify
# Optional extra buckets to create at startup (comma-separated)
# S3_BUCKETS=supplify,supplify-media
# Browser-facing MinIO URL (native dev / mapped port 9000)
S3_PUBLIC_URL=http://localhost:9000
S3_PUBLIC_READ=true
MINIO_PUBLIC_READ=true

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PORT=6379

# ── API ──────────────────────────────────────────────────────────────────────
SESSION_SECRET=dev-session-secret-change-me
NODE_ENV=development
STAFF_PORTAL_BASE_URL=http://localhost

# ── SMTP (staff magic links; optional in local dev) ─────────────────────────
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_FROM=noreply@supplify.local

{
  "name": "supplify",
  "version": "1.0.0",
  "description": "Supplify - Restaurant & F&B Supplier Marketplace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @supplify/api build && pnpm --filter @supplify/web build",
    "db:migrate": "node apps/api/scripts/migrate.js",
    "db:sync-roles": "node apps/api/scripts/sync-system-roles.mjs",
    "setup": "node scripts/ensure-pnpm.mjs && node scripts/pnpm-run.mjs install"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.9",
  "lint-staged": {
    "apps/web/**/*.{ts,tsx}": [
      "eslint --fix --max-warnings 0 --report-unused-disable-directives --config apps/web/.eslintrc.cjs",
      "prettier --write"
    ],
    "apps/api/**/*.{js,jsx}": [
      "node scripts/pnpm-run.mjs --filter @supplify/api lint:fix",
      "prettier --write"
    ],
    "*.{js,jsx,ts,tsx}": [
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "fast-xml-parser": ">=5.3.5",
      "handlebars": ">=4.7.9",
      "ws": ">=8.21.0",
      "qs": ">=6.14.2",
      "socket.io-parser": ">=4.2.6",
      "express>path-to-regexp": "0.1.12",
      "glob": ">=10.5.0",
      "minimatch": ">=9.0.7",
      "picomatch": ">=2.3.2",
      "lodash": ">=4.18.0",
      "fast-uri": ">=3.1.2",
      "form-data": ">=4.0.6"
    }
  }
}

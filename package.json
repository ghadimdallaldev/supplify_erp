{
  "name": "supplify",
  "version": "1.0.0",
  "description": "Supplify - Restaurant & F&B Supplier Marketplace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-native.mjs",
    "dev:apps": "node scripts/dev-apps.mjs",
    "dev:docker": "node scripts/run-local.mjs up",
    "build": "pnpm --filter @supplify/api build && pnpm --filter @supplify/web build",
    "typecheck": "pnpm --filter @supplify/web type-check",
    "lint": "pnpm --filter @supplify/api lint && pnpm --filter @supplify/web lint",
    "lint:fix": "pnpm --filter @supplify/api lint:fix && pnpm --filter @supplify/web lint:fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "test": "pnpm --filter @supplify/api test && pnpm --filter @supplify/web test",
    "test:ci": "node scripts/pnpm-run.mjs --filter @supplify/api test:run && node scripts/pnpm-run.mjs --filter @supplify/web test:run",
    "qa": "pnpm lint && pnpm typecheck && pnpm test:ci && pnpm build",
    "e2e": "pnpm --filter @supplify/api test:e2e",
    "e2e:playwright": "node tests/scripts/probe-urls.mjs && playwright test --config=tests/playwright.config.ts",
    "test:coverage-map": "node tests/scripts/check-coverage-map.mjs",
    "db:migrate": "node apps/api/scripts/migrate.js",
    "db:sync-roles": "node apps/api/scripts/sync-system-roles.mjs",
    "db:migrate-users-to-roles": "node apps/api/scripts/migrate-users-to-roles.js",
    "db:migrate-suppliers-to-orgs": "node apps/api/scripts/migrate-suppliers-to-orgs.js",
    "db:migrate-restaurants-to-orgs": "node apps/api/scripts/migrate-restaurants-to-orgs.js",
    "db:seed": "pnpm --filter @supplify/api db:seed",
    "seed:prodlike": "pnpm --filter @supplify/api seed:prodlike",
    "seed:accounts": "pnpm --filter @supplify/api seed:accounts",
    "seed:quick-lists": "pnpm --filter @supplify/api seed:quick-lists",
    "seed:chats": "pnpm --filter @supplify/api seed:chats",
    "seed:demo-users": "pnpm --filter @supplify/api seed:demo-users",
    "seed:demo-tenants": "node scripts/pnpm-run.mjs --filter @supplify/api seed:demo-tenants",
    "seed:plan-tiers": "node scripts/pnpm-run.mjs --filter @supplify/api seed:plan-tiers",
    "seed:billing": "node scripts/pnpm-run.mjs --filter @supplify/api seed:billing",
    "seed:prodlike-team": "node scripts/pnpm-run.mjs --filter @supplify/api seed:prodlike-team",
    "seed:full": "node scripts/pnpm-run.mjs --filter @supplify/api seed:full",
    "seed:features": "node scripts/pnpm-run.mjs --filter @supplify/api seed:features",
    "seed:tier-catalog": "node apps/api/scripts/seed-tier-catalog.mjs",
    "seed:audit-backfill": "node apps/api/scripts/seed-audit-backfill.mjs",
    "db:reset": "pnpm --filter @supplify/api db:reset",
    "db:wipe-commercial": "pnpm --filter @supplify/api db:wipe-commercial",
    "storage:ensure-buckets": "pnpm --filter @supplify/api storage:ensure-buckets",
    "openapi:gen": "pnpm --filter @supplify/api openapi:gen",
    "cdk:bootstrap": "cd infra && pnpm install && pnpm bootstrap",
    "cdk:deploy": "cd infra && pnpm install && pnpm deploy",
    "cdk:deploy:dev": "cd infra && pnpm install && pnpm deploy:dev",
    "cdk:deploy:staging": "cd infra && pnpm install && pnpm deploy:staging",
    "cdk:deploy:prod": "cd infra && pnpm install && pnpm deploy:prod",
    "cdk:synth": "cd infra && pnpm install && pnpm synth",
    "cdk:synth:dev": "cd infra && pnpm install && pnpm synth:dev",
    "cdk:synth:staging": "cd infra && pnpm install && pnpm synth:staging",
    "cdk:synth:prod": "cd infra && pnpm install && pnpm synth:prod",
    "cdk:destroy": "cd infra && pnpm install && pnpm destroy",
    "cdk:destroy:dev": "cd infra && pnpm install && pnpm destroy:dev",
    "cdk:destroy:staging": "cd infra && pnpm install && pnpm destroy:staging",
    "cdk:destroy:prod": "cd infra && pnpm install && pnpm destroy:prod",
    "deploy:dev": "bash deploy/scripts/deploy-dev.sh",
    "deploy:staging": "bash deploy/scripts/deploy-staging.sh",
    "deploy:preprod": "bash deploy/scripts/deploy-preprod.sh",
    "deploy:prod": "bash deploy/scripts/deploy-prod.sh",
    "promote:preprod": "node scripts/promote-release.mjs --tier preprod",
    "promote:prod": "node scripts/promote-release.mjs --tier prod",
    "local:up": "node scripts/run-local.mjs up",
    "local:dev": "node scripts/dev-native.mjs",
    "local:infra": "node scripts/dev-infra.mjs",
    "local:down": "node scripts/run-local.mjs down",
    "local:logs": "node scripts/run-local.mjs logs",
    "local:status": "node scripts/run-local.mjs status",
    "local:seed": "node scripts/run-local.mjs seed",
    "docker:up": "node scripts/run-local.mjs up",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps",
    "docker:prod:up": "docker compose --env-file deploy/env/.env.prod -f deploy/docker-compose.prod.yml up -d",
    "docker:prod:down": "docker compose --env-file deploy/env/.env.prod -f deploy/docker-compose.prod.yml down",
    "docker:prod:logs": "docker compose --env-file deploy/env/.env.prod -f deploy/docker-compose.prod.yml logs -f",
    "setup": "node scripts/ensure-pnpm.mjs && node scripts/pnpm-run.mjs install",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@commitlint/cli": "^18.6.0",
    "@commitlint/config-conventional": "^18.6.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^9.0.7",
    "@types/node": "^20.10.0",
    "concurrently": "^8.2.2",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.0",
    "pnpm": "8.15.9",
    "semantic-release": "^22.0.12",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.9",
  "pnpm": {
    "overrides": {
      "fast-xml-parser": ">=5.3.5",
      "handlebars": ">=4.7.9"
    }
  }
}

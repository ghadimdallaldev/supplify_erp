{
  "name": "supplify",
  "version": "1.0.0",
  "description": "Supplify - Restaurant & F&B Supplier Marketplace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @supplify/api build && pnpm --filter @supplify/web build",
    "db:migrate": "node apps/api/scripts/migrate.js",
    "db:sync-roles": "node apps/api/scripts/sync-system-roles.mjs",
    "deploy:preprod": "bash deploy/scripts/deploy-preprod.sh",
    "deploy:prod": "bash deploy/scripts/deploy-prod.sh",
    "railway:keycloak:sync": "node scripts/railway-sync-keycloak.mjs",
    "promote:preprod": "node scripts/promote-release.mjs --tier preprod",
    "promote:prod": "node scripts/promote-release.mjs --tier prod",
    "local:up": "node scripts/run-local.mjs up",
    "local:dev": "node scripts/dev-native.mjs",
    "local:infra": "node scripts/dev-infra.mjs",
    "local:down": "node scripts/run-local.mjs down",
    "local:logs": "node scripts/run-local.mjs logs",
    "local:status": "node scripts/run-local.mjs status",
    "memory:measure": "node scripts/measure-memory.mjs",
    "memory:prod-api": "node scripts/memory-prod-api-smoke.mjs",
    "local:seed": "node scripts/run-local.mjs seed",
    "docker:up": "node scripts/run-local.mjs up",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps",
    "docker:prod:up": "docker compose --env-file deploy/env/.env.prod -f deploy/docker-compose.prod.yml up -d",
    "docker:prod:down": "docker compose --env-file deploy/env/.env.prod -f deploy/docker-compose.prod.yml down",
    "docker:prod:logs": "docker compose --env-file deploy/env/.env.prod -f deploy/docker-compose.prod.yml logs -f",
    "setup": "node scripts/ensure-pnpm.mjs && node scripts/pnpm-run.mjs install",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@commitlint/cli": "^18.6.0",
    "@commitlint/config-conventional": "^18.6.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^9.0.7",
    "@types/node": "^20.10.0",
    "concurrently": "^8.2.2",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.0",
    "pnpm": "8.15.9",
    "semantic-release": "^22.0.12",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.9"
}
